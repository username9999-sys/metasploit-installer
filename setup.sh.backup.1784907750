    cat > "$D/scripts/daily_scan.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Daily automated recon scan — nmap + nuclei + msf modules
set -euo pipefail
TARGET="${1:-}"; OUTPUT_DIR="${2:-$HOME/scan-output/$(date +%Y%m%d)}"
mkdir -p "$OUTPUT_DIR"
log()  { echo -e "\033[0;32m[✓]\033[0m $*"; }
warn() { echo -e "\033[1;33m[!]\033[0m $*"; }
echo -e "\n=== DAILY SCAN — $(date '+%Y-%m-%d %H:%M') ===\n"

scan_nmap() {
    log "Phase 1: nmap quick scan..."
    nmap -sS -T4 --top-ports 1000 "${TARGET:-192.168.1.0/24}" -oA "$OUTPUT_DIR/nmap-quick" 2>&1 | tail -5
    log "Phase 2: nmap service scan (top targets)..."
    grep "open" "$OUTPUT_DIR/nmap-quick.gnmap" 2>/dev/null | awk '{print $2}' | sort -u > "$OUTPUT_DIR/live-hosts.txt"
    local count; count=$(wc -l < "$OUTPUT_DIR/live-hosts.txt" 2>/dev/null || echo 0)
    [[ "$count" -gt 0 ]] && nmap -sV -sC --top-ports 100 -iL "$OUTPUT_DIR/live-hosts.txt" -oA "$OUTPUT_DIR/nmap-services" 2>&1 | tail -5
}

scan_nuclei() {
    log "Phase 3: nuclei vulnerability scan..."
    [[ "$count" -gt 0 ]] && nuclei -l "$OUTPUT_DIR/live-hosts.txt" -t ~/nuclei-templates/ -severity critical,high -o "$OUTPUT_DIR/nuclei-results.txt" 2>&1 | tail -5 || warn "No hosts to scan"
}

msf_recon() {
    log "Phase 4: msfconsole modules..."
    msfconsole -q -x "
      db_nmap -sS -T4 --top-ports 100 "${TARGET:-192.168.1.0/24}";
      hosts; services; vulns;
      exit;
    " 2>&1 | tail -10 || warn "msfconsole not available"
}

generate_summary() {
    cat > "$OUTPUT_DIR/summary.md" << SUMMD
# Daily Scan — $(date '+%Y-%m-%d')

| Item | Result |
|------|--------|
| Hosts scanned | $(wc -l < "$OUTPUT_DIR/live-hosts.txt" 2>/dev/null || echo 0) |
| Open ports | $(grep -c "open" "$OUTPUT_DIR/nmap-quick.gnmap" 2>/dev/null || echo 0) |
| Nuclei findings | $(wc -l < "$OUTPUT_DIR/nuclei-results.txt" 2>/dev/null || echo 0) |

## Top ports
$(grep "open" "$OUTPUT_DIR/nmap-quick.gnmap" 2>/dev/null | awk '{print $5}' | sed 's/open\///' | sort | uniq -c | sort -rn | head -10)
SUMMD
    log "Summary: $OUTPUT_DIR/summary.md"
}

scan_nmap; scan_nuclei; msf_recon; generate_summary
echo -e "\n=== SCAN COMPLETE — Output: $OUTPUT_DIR ===\n"
EOF

    cat > "$D/scripts/telegram_notify.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Telegram notification via Bot API
set -euo pipefail
BOT_TOKEN="${TELEGRAM_BOT_TOKEN:-}"; CHAT_ID="${TELEGRAM_CHAT_ID:-}"
[[ -z "$BOT_TOKEN" || -z "$CHAT_ID" ]] && { echo "[!] TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID not set in config.env"; exit 0; }

send_telegram() {
    local text="${1:-Operation completed}"
    local resp; resp=$(curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
      -d "chat_id=${CHAT_ID}" -d "text=${text}" -d "parse_mode=HTML" 2>/dev/null)
    local ok; ok=$(echo "$resp" | jq -r '.ok // false' 2>/dev/null)
    if [[ "$ok" == "true" ]]; then
        echo "[✓] Telegram sent: $text"
    else
        echo "[✗] Telegram failed: $resp"
    fi
}

send_file() {
    local file="$1" caption="${2:-File attached}"
    [[ ! -f "$file" ]] && { echo "[✗] File not found: $file"; return 1; }
    curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendDocument" \
      -F "chat_id=${CHAT_ID}" -F "document=@${file}" -F "caption=${caption}" >/dev/null 2>&1 && \
      echo "[✓] File sent: $file" || echo "[✗] File send failed: $file"
}

# If called with args, send message
[[ "${1:-}" != "" ]] && send_telegram "$1"
[[ "${2:-}" != "" ]] && send_file "$2"
EOF

