<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MSF Dashboard — Live Operations</title>
    <link rel="stylesheet" href="/static/style.css">
    <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
</head>
<body>
    <header class="topbar">
        <h1>⚔️ Metasploit Operations Dashboard</h1>
        <span id="uptime">⏱ Uptime: --</span>
    </header>

    <main class="grid-container">
        <section class="card stat-grid" id="stats-panel">
            <div class="stat"><span class="stat-num" id="stat-sessions">0</span><span class="stat-label">Sessions</span></div>
            <div class="stat"><span class="stat-num" id="stat-hosts">0</span><span class="stat-label">Hosts</span></div>
            <div class="stat"><span class="stat-num" id="stat-services">0</span><span class="stat-label">Services</span></div>
            <div class="stat"><span class="stat-num" id="stat-vulns">0</span><span class="stat-label">Vulns</span></div>
            <div class="stat"><span class="stat-num" id="stat-loot">0</span><span class="stat-label">Loot</span></div>
        </section>

        <section class="card" id="tools-panel">
            <h2>🛠 Tools Available</h2>
            <div id="tools-list"></div>
        </section>

        <section class="card" id="events-panel">
            <h2>📋 Live Events</h2>
            <div id="events-feed"></div>
        </section>

        <section class="card" id="ai-panel">
            <h2>🤖 AI Assistant</h2>
            <textarea id="ai-question" placeholder="Ask: What exploits target Apache 2.4.49?" rows="3"></textarea>
            <button id="ai-ask-btn">▶ Ask AI</button>
            <pre id="ai-response"></pre>
        </section>

        <section class="card" id="cmd-panel">
            <h2>⚡ Quick Actions</h2>
            <button onclick="quickCmd('health')">🔍 Health Check</button>
            <button onclick="quickCmd('sessions')">📡 List Sessions</button>
            <button onclick="quickCmd('snapshot')">📸 Snapshot</button>
            <button onclick="quickCmd('report')">📊 Generate Report</button>
        </section>
    </main>

    <script>
        const socket = io();
        socket.on('connect', () => console.log('[WS] Connected'));

        socket.on('stats_update', (data) => {
            document.getElementById('stat-sessions').textContent = data.sessions;
            document.getElementById('stat-hosts').textContent = data.hosts;
            document.getElementById('stat-services').textContent = data.services;
            document.getElementById('stat-vulns').textContent = data.vulns;
            document.getElementById('stat-loot').textContent = data.loot;
            document.getElementById('uptime').textContent = '⏱ Uptime: ' + (data.uptime || '--');
            const toolsDiv = document.getElementById('tools-list');
            toolsDiv.innerHTML = Object.entries(data.tools || {}).map(([k,v]) =>
                `<span class="tool-badge ${v ? 'green' : 'red'}">${k}</span>`).join('');
        });

        socket.on('new_event', (ev) => {
            const feed = document.getElementById('events-feed');
            const div = document.createElement('div');
            div.className = 'event-item';
            div.innerHTML = `<span class="event-ts">${new Date(ev.ts).toLocaleTimeString()}</span>
                             <span class="event-type ${ev.type}">[${ev.type.toUpperCase()}]</span>
                             <span class="event-msg">${ev.msg}</span>`;
            feed.prepend(div);
            if (feed.children.length > 50) feed.lastChild.remove();
        });

        document.getElementById('ai-ask-btn').addEventListener('click', () => {
            const q = document.getElementById('ai-question').value.trim();
            if (!q) return;
            document.getElementById('ai-response').textContent = 'Thinking...';
            socket.emit('ask_ai', {q});
        });

        socket.on('ai_response', (data) => {
            document.getElementById('ai-response').textContent = data.answer;
        });

        function quickCmd(action) {
            fetch('/api/event', {method:'POST',headers:{'Content-Type':'application/json'},
                body:JSON.stringify({type:'action',msg:`Quick action: ${action} requested`})});
        }

        // Initial stats load
        fetch('/api/stats').then(r=>r.json()).then(d=>{socket.emit('stats_update',d);});
    </script>
</body>
</html>
HTMLEOF

