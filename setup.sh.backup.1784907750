# ──────────────────────────────────────────────────────────────────────────────
# PHASE 6: ORCHESTRATION — do_full_install(), main(), Git lifecycle, final output
# ──────────────────────────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────────────
# do_full_install() — Complete automated installation pipeline
# ──────────────────────────────────────────────────────────────────
do_full_install() {
    local start_time; start_time=$(date +%s)
    title "═══════════════════════════════════════════════════════════════"
    title "  METASPLOIT INSTALLER — FULL AUTOMATED INSTALLATION"
    title "═══════════════════════════════════════════════════════════════"
    echo ""
    info "Mode: ${USER_MODE} | Distro: ${DISTRO_ID} (${OS_FAMILY}) | Arch: ${ARCH}"
    info "Install dir: ${INSTALL_DIR}"
    info "Starting full install pipeline..."
    echo ""

    # 1. Idempotency check + backup
    step "Phase 1/11: Idempotency Check"
    check_idempotency || return 1

    # 2. Snapshot before changes
    step "Phase 2/11: Pre-install Snapshot"
    take_snapshot "pre"

    # 3. Create directory structure
    step "Phase 3/11: Directory Structure"
    create_directory_structure

    # 4. Populate all files (heredoc extraction)
    step "Phase 4/11: File Population"
    populate_all_files

    # 5. Install system dependencies
    step "Phase 5/11: System Dependencies"
    do_install_deps

    # 6. Install Go tools
    step "Phase 6/11: Go Tools"
    install_go_tools

    # 7. Install Python tools
    step "Phase 7/11: Python Tools"
    install_python_tools

    # 8. Install Metasploit Framework
    step "Phase 8/11: Metasploit Framework"
    do_install_metasploit

    # 9. Install Dashboard
    step "Phase 9/11: Web Dashboard"
    install_dashboard

    # 10. Setup PATH persistence
    step "Phase 10/11: PATH Configuration"
    setup_path

    # 11. Post-install verification
    step "Phase 11/11: Verification & Reporting"
    generate_report
    run_smoke_test
    do_snapshot_diff "pre" "post"

    local end_time; end_time=$(date +%s)
    local duration=$((end_time - start_time))
    local mins=$((duration / 60))
    local secs=$((duration % 60))

    # Git lifecycle
    auto_git_lifecycle

    # Final success banner
    print_final_banner "${mins}m ${secs}s"
    mark_done "full_install"
}

# ──────────────────────────────────────────────────────────────────
# auto_git_lifecycle() — Initialize repo, commit, push if configured
# ──────────────────────────────────────────────────────────────────
auto_git_lifecycle() {
    step "Git Lifecycle Automation"

    # Check if git already initialized
    if [[ -d "$INSTALL_DIR/.git" ]]; then
        info "Git repository already exists — skipping init"
    else
        if command -v git &>/dev/null; then
            info "Initializing git repository..."
            git -C "$INSTALL_DIR" init 2>/dev/null && log "Git init complete" || warn "Git init failed"
        else
            warn "git not installed — skipping Git lifecycle"
            return
        fi
    fi

    # Create .gitignore if not exists
    if [[ ! -f "$INSTALL_DIR/.gitignore" ]]; then
        cat > "$INSTALL_DIR/.gitignore" << 'GITIGNORE'
# Metasploit Installer - Auto-generated .gitignore
.env
config.env
*.log
*.tmp
*.pid
*.state
.cache/
06-logs/
.vscode/
.idea/
*.swp
*.bak
*.orig
.DS_Store
Thumbs.db
GITIGNORE
        log ".gitignore created"
    fi

    # Add all files
    info "Staging changes..."
    git -C "$INSTALL_DIR" add . 2>/dev/null || warn "git add failed"

    # Commit if there are changes
    if ! git -C "$INSTALL_DIR" diff --cached --quiet 2>/dev/null; then
        local commit_msg="feat: full install $(date '+%Y-%m-%d %H:%M')"
        info "Committing: $commit_msg"
        git -C "$INSTALL_DIR" commit -m "$commit_msg" 2>/dev/null && log "Commit complete" || warn "Commit failed"
    else
        info "No changes to commit"
    fi

    # Push if GITHUB_REPO_URL is set and AUTO_PUSH=true
    if [[ -n "${GITHUB_REPO_URL:-}" && "${AUTO_PUSH:-false}" == "true" ]]; then
        info "Pushing to $GITHUB_REPO_URL..."
        git -C "$INSTALL_DIR" remote get-url origin 2>/dev/null || \
            git -C "$INSTALL_DIR" remote add origin "$GITHUB_REPO_URL" 2>/dev/null
        git -C "$INSTALL_DIR" push -u origin main 2>/dev/null && log "Push complete" || warn "Push failed — check credentials/remote"
    else
        [[ -z "${GITHUB_REPO_URL:-}" ]] && info "GITHUB_REPO_URL not set — skipping push"
        [[ "${AUTO_PUSH:-false}" != "true" ]] && info "AUTO_PUSH=false — skipping push"
    fi
}

# ──────────────────────────────────────────────────────────────────
# audit_self() — Self-audit all files and dependencies
# ──────────────────────────────────────────────────────────────────
audit_self() {
    step "Self-Audit & Validation"
    local audit_log="$INSTALL_DIR/06-logs/audit_self_$(date +%Y%m%d_%H%M%S).log"
    mkdir -p "$INSTALL_DIR/06-logs"

    {
        echo "=== METASPLOIT INSTALLER SELF-AUDIT ==="
        echo "Timestamp: $(date -Iseconds)"
        echo "Install Dir: $INSTALL_DIR"
        echo ""

        echo "── File Inventory ──"
        find "$INSTALL_DIR" -type f -name "*.sh" | sort | while IFS= read -r f; do
            local size; size=$(wc -l < "$f")
            echo "$f ($size lines)"
        done
        echo ""

        echo "── Syntax Check (bash -n) ──"
        local syntax_ok=0 syntax_fail=0
        find "$INSTALL_DIR" -type f -name "*.sh" | while IFS= read -r f; do
            if bash -n "$f" 2>/dev/null; then
                echo "  [✓] $f"
                ((syntax_ok++))
            else
                echo "  [✗] $f — SYNTAX ERROR"
                ((syntax_fail++))
            fi
        done
        echo "  Total: $syntax_ok passed, $syntax_fail failed"
        echo ""

        echo "── Shebang Check ──"
        find "$INSTALL_DIR" -type f -name "*.sh" | while IFS= read -r f; do
            local first_line; first_line=$(head -1 "$f")
            if [[ "$first_line" == "#!/usr/bin/env bash" ]] || [[ "$first_line" == "#!/bin/bash" ]]; then
                echo "  [✓] $f"
            else
                echo "  [!] $f — missing/incorrect shebang: $first_line"
            fi
        done
        echo ""

        echo "── set -euo pipefail Check ──"
        find "$INSTALL_DIR" -type f -name "*.sh" | while IFS= read -r f; do
            if grep -q "set -euo pipefail" "$f"; then
                echo "  [✓] $f"
            else
                echo "  [!] $f — missing 'set -euo pipefail'"
            fi
        done
        echo ""

        echo "── External Dependency Check ──"
        for tool in nmap msfconsole msfvenom python3 python pipx go git curl wget ruby bundle psql hashcat john ffuf nuclei subfinder httpx sqlmap hydra crackmapexec nikto enum4linux bloodhound amass gau waybackurls qsreplace dalfox whatweb userevac/web-analyze; do
            if command -v "$tool" &>/dev/null; then
                echo "  [✓] $tool"
            else
                echo "  [*] $tool — not in PATH (may be in ~/go/bin or pipx bin)"
            fi
        done
        echo ""

        echo "── Module Load Test ──"
        if [[ -f "$INSTALL_DIR/msf-run.sh" ]]; then
            bash "$INSTALL_DIR/msf-run.sh" modules 2>&1 | head -30
        fi

    } | tee "$audit_log"

    log "Audit log saved: $audit_log"
}

