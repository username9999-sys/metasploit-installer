#!/usr/bin/env python3
"""Metasploit Dashboard — Live session tracker, loot viewer, AI chat"""
import os, json, time, threading, subprocess
from datetime import datetime
from flask import Flask, render_template, request, jsonify
from flask_socketio import SocketIO, emit

app = Flask(__name__)
app.config['SECRET_KEY'] = os.environ.get('DASHBOARD_SECRET', os.urandom(24).hex())
socketio = SocketIO(app, cors_allowed_origins="*", async_mode='threading')

STATS = {
    'sessions': 0, 'hosts': 0, 'services': 0, 'vulns': 0, 'loot': 0,
    'uptime': '', 'started': datetime.now().isoformat(), 'events': [],
    'tools': {'nmap': False, 'msfconsole': False, 'hashcat': False, 'john': False}
}

def bg_stats_updater():
    """Update tool availability every 30s"""
    while True:
        for tool in STATS['tools']:
            STATS['tools'][tool] = subprocess.run(['command','-v',tool], capture_output=True).returncode == 0
        STATS['uptime'] = str(datetime.now() - datetime.fromisoformat(STATS['started'])).split('.')[0]
        socketio.sleep(30)

def add_event(event_type, message):
    STATS['events'].append({'type': event_type, 'msg': message, 'ts': datetime.now().isoformat()})
    if len(STATS['events']) > 100:
        STATS['events'] = STATS['events'][-100:]
    socketio.emit('new_event', {'type': event_type, 'msg': message, 'ts': STATS['events'][-1]['ts']})

@app.route('/')
def index():
    return render_template('index.html', stats=STATS)

@app.route('/api/stats')
def api_stats():
    return jsonify(STATS)

@app.route('/api/event', methods=['POST'])
def api_event():
    data = request.get_json(silent=True) or {}
    add_event(data.get('type','info'), data.get('msg',''))
    return jsonify({'status':'ok'})

@app.route('/api/sessions', methods=['POST'])
def api_sessions():
    data = request.get_json(silent=True) or {}
    STATS['sessions'] = data.get('sessions', STATS['sessions'])
    STATS['hosts'] = data.get('hosts', STATS['hosts'])
    socketio.emit('stats_update', STATS)
    return jsonify({'status':'ok'})

@app.route('/health')
def health():
    return jsonify({'status':'ok','uptime':STATS['uptime']})

@socketio.on('connect')
def on_connect():
    emit('stats_update', STATS)

@socketio.on('ask_ai')
def on_ask_ai(data):
    question = data.get('q','')
    try:
        script_dir = os.path.dirname(os.path.abspath(__file__))
        result = subprocess.run(
            ['bash', os.path.join(script_dir, '../../lib/llm_helper.sh')],
            input=question, capture_output=True, text=True, timeout=60
        )
        emit('ai_response', {'answer': result.stdout or result.stderr or 'No response'})
    except Exception as e:
        emit('ai_response', {'answer': f'AI error: {str(e)}'})

def main():
    port = int(os.environ.get('DASHBOARD_PORT', 8080))
    print(f"[*] Dashboard starting on http://0.0.0.0:{port}")
    threading.Thread(target=bg_stats_updater, daemon=True).start()
    socketio.run(app, host='0.0.0.0', port=port, debug=False, allow_unsafe_werkzeug=True)

if __name__ == '__main__':
    main()
PYEOF

