#!/usr/bin/env bash
# Description: Vuln lab spawner — DVWA + Metasploitable2 + Kali
set -euo pipefail
LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ACTION="${1:-up}"

log()  { echo -e "\033[0;32m[✓]\033[0m $*"; }
warn() { echo -e "\033[1;33m[!]\033[0m $*"; }

if ! command -v docker &>/dev/null; then
    warn "Docker not installed. Install: sudo apt install docker.io docker-compose"
    warn "Then: sudo usermod -aG docker $USER"
    exit 1
fi

case "$ACTION" in
    up|start)
        log "Starting vuln lab..."
        cd "$LAB_DIR" && docker-compose up -d 2>/dev/null || docker compose up -d 2>/dev/null
        log "Lab running! Targets:"
        echo "  DVWA:            http://localhost:8081"
        echo "  Metasploitable2: http://localhost:8082"
        echo "  MS2 SSH:         localhost:8084 (user: msfadmin / pass: msfadmin)"
        echo "  MS2 Telnet:      localhost:8085 (user: msfadmin / pass: msfadmin)"
        echo "  MS2 SMB:         localhost:8087"
        echo "  Kali attacker:   docker exec -it kali-attacker bash"
        ;;
    down|stop)
        log "Stopping vuln lab..."
        cd "$LAB_DIR" && docker-compose down 2>/dev/null || docker compose down 2>/dev/null
        ;;
    status)
        docker ps --filter "name=dvwa" --filter "name=metasploitable2" --filter "name=kali-attacker"
        ;;
    *)
        echo "Usage: bash lab-spawn.sh [up|down|status]"
        ;;
esac
