    cat > "$D/lib/llm_helper.sh" << 'EOF'
#!/usr/bin/env bash
# Description: LLM Exploit Assistant — Ollama or OpenAI for pentest guidance
# ==============================================================================
source "${BASH_SOURCE[0]%/*}/common.sh" 2>/dev/null || true

OPENAI_API_KEY="${OPENAI_API_KEY:-}"; OLLAMA_MODEL="${OLLAMA_MODEL:-llama3}"

ask_ai() {
    local question="${*:-}"
    [[ -z "$question" ]] && { read -r -p "  [?] Your question: " question; }
    local ctx="Target OS: ${TARGET_OS:-unknown}, Ports: ${TARGET_PORTS:-unknown}, Service: ${TARGET_SVC:-unknown}"
    local full_q="$ctx — $question"

    if cmd_exists ollama && ollama list 2>/dev/null | grep -q "$OLLAMA_MODEL"; then
        echo -e "\n  ${BLUE}[AI-Ollama]${NC} Asking $OLLAMA_MODEL..."
        ollama run "$OLLAMA_MODEL" "$full_q" 2>/dev/null || warn "Ollama error"
    elif [[ -n "$OPENAI_API_KEY" ]]; then
        echo -e "\n  ${BLUE}[AI-OpenAI]${NC} Querying GPT-4o-mini..."
        local resp; resp=$(curl -s https://api.openai.com/v1/chat/completions \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer $OPENAI_API_KEY" \
            -d "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"system\",\"content\":\"You are a pentest assistant. Give direct, actionable commands.\"},{\"role\":\"user\",\"content\":\"$full_q\"}]}" 2>/dev/null)
        echo "$resp" | python3 -c "import sys,json;print(json.load(sys.stdin)['choices'][0]['message']['content'])" 2>/dev/null || warn "OpenAI parse failed"
    else
        warn "No AI backend. Install Ollama or set OPENAI_API_KEY in config.env"
        info "Install Ollama: curl -fsSL https://ollama.com/install.sh | sh && ollama pull llama3"
    fi
}
EOF

