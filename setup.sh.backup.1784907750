echo "  # Kubelet API (port 10250):"
echo "  curl -k https://<NODE_IP>:10250/runningpods/"
echo ""
echo "[*] 6. Escape detection (check for weak isolation):"
echo "  cat /proc/1/cgroup | grep -v 'docker\|kubepods\|containerd'"
echo "  ip link; ip addr; route -n; arp -a"
echo "  # Sensitive mounts:"
echo "  mount | grep -E '/proc|/sys|/dev|/var/run/docker.sock'"
echo -e "\n=== DONE ===\n"
EOF
