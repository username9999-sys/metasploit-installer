#!/usr/bin/env bash
# Description: External API integrations — VirusTotal, Shodan, NVD, Censys
# ==============================================================================
VT_API_KEY="${VT_API_KEY:-}"; SHODAN_API_KEY="${SHODAN_API_KEY:-}"
CENSYS_UID="${CENSYS_UID:-}"; CENSYS_SECRET="${CENSYS_SECRET:-}"

check_virustotal() {
    local ip="${1:-}"; [[ -z "$ip" || -z "$VT_API_KEY" ]] && { warn "Need IP and VT_API_KEY"; return 1; }
    echo -e "\n=== VirusTotal: $ip ===\n"
    curl -s "https://www.virustotal.com/api/v3/ip_addresses/$ip" \
        -H "x-apikey: $VT_API_KEY" 2>/dev/null | python3 -m json.tool 2>/dev/null | head -30
}

check_shodan() {
    local ip="${1:-}"; [[ -z "$ip" || -z "$SHODAN_API_KEY" ]] && { warn "Need IP and SHODAN_API_KEY"; return 1; }
    echo -e "\n=== Shodan: $ip ===\n"
    curl -s "https://api.shodan.io/shodan/host/$ip?key=$SHODAN_API_KEY" 2>/dev/null | python3 -m json.tool 2>/dev/null | head -30
}

check_nvd() {
    local cve="${1:-}"; [[ -z "$cve" ]] && { warn "Need CVE ID (e.g. CVE-2021-4034)"; return 1; }
    echo -e "\n=== NVD: $cve ===\n"
    curl -s "https://services.nvd.nist.gov/rest/json/cves/2.0?cveId=$cve" 2>/dev/null | python3 -m json.tool 2>/dev/null | head -30
}

check_censys() {
    local ip="${1:-}"; [[ -z "$ip" || -z "$CENSYS_UID" ]] && { warn "Need IP and CENSYS_UID/CENSYS_SECRET"; return 1; }
    echo -e "\n=== Censys: $ip ===\n"
    curl -s -u "${CENSYS_UID}:${CENSYS_SECRET}" "https://search.censys.io/api/v2/hosts/$ip" 2>/dev/null | python3 -m json.tool 2>/dev/null | head -30
}
EOF
