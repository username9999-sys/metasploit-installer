    [[ -z "$question" ]] && { echo "Usage: ask_ai '<prompt>'"; echo "  ask_ai 'What exploits work against Apache 2.4.49?'"; return 1; }
    echo -e "\n=== AI ASSISTANT ($LLM_PROVIDER / $LLM_MODEL) ===\n"
    echo "[*] Question: $question"
    echo ""

    case "$LLM_PROVIDER" in
        ollama)
            if ! command -v ollama &>/dev/null; then
                echo "[!] ollama not installed. Install: curl -fsSL https://ollama.ai/install.sh | sh"
                echo "[*] Falling back to offline reference..."
                echo "  search Apache 2.4.49 → exploit/multi/http/apache_path_traversal"
                return 1
            fi
            echo "[*] Asking Ollama ($LLM_MODEL)..."; echo "---"
            curl -s "http://${OLLAMA_HOST}/api/generate" -d "{\"model\":\"$LLM_MODEL\",\"prompt\":\"$question\",\"stream\":false}" 2>/dev/null | jq -r '.response' 2>/dev/null || echo "[!] Ollama query failed"
            ;;
        openai)
            if [[ -z "$OPENAI_KEY" ]]; then
                echo "[!] OPENAI_API_KEY not set in config.env"; return 1
            fi
            echo "[*] Asking OpenAI (gpt-4o-mini)..."; echo "---"
            curl -s https://api.openai.com/v1/chat/completions \
              -H "Authorization: Bearer $OPENAI_KEY" \
              -H "Content-Type: application/json" \
              -d "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"$question\"}],\"max_tokens\":500}" 2>/dev/null | jq -r '.choices[0].message.content' 2>/dev/null || echo "[!] OpenAI API failed"
            ;;
        *)
            echo "[!] Unknown provider: $LLM_PROVIDER. Use 'ollama' or 'openai'."
            return 1
            ;;
    esac
    echo "---"; echo -e "\n=== DONE ===\n"
}

[[ "${1:-}" != "" ]] && ask_ai "$1"
EOF

    cat > "$D/lib/external_api.sh" << 'EOF'
#!/usr/bin/env bash
# Description: External API integrations — VirusTotal, Shodan, NVD, Censys
set -euo pipefail
VT_API_KEY="${VT_API_KEY:-}"; SHODAN_API_KEY="${SHODAN_API_KEY:-}"
NVD_API_KEY="${NVD_API_KEY:-}"; CENSYS_UID="${CENSYS_UID:-}"; CENSYS_SECRET="${CENSYS_SECRET:-}"

check_virustotal() {
    local target="${1:-}"; [[ -z "$VT_API_KEY" ]] && { echo "[!] VT_API_KEY not set"; return 1; }
    local hash; hash=$(sha256sum "$target" 2>/dev/null | cut -d' ' -f1) || hash="$target"
    echo "[*] VirusTotal lookup: $hash"
    local resp; resp=$(curl -s "https://www.virustotal.com/api/v3/files/${hash}" -H "x-apikey: $VT_API_KEY" 2>/dev/null)
    local malicious; malicious=$(echo "$resp" | jq -r '.data.attributes.last_analysis_stats.malicious // "N/A"' 2>/dev/null)
    echo "  Malicious detections: $malicious"
    echo "$resp" | jq '.data.attributes.last_analysis_results | to_entries[] | select(.value.category == "malicious") | "  \(.key): \(.value.result)"' -r 2>/dev/null
}

check_shodan() {
    local target="${1:-}"; [[ -z "$SHODAN_API_KEY" ]] && { echo "[!] SHODAN_API_KEY not set"; return 1; }
    echo "[*] Shodan host lookup: $target"
    curl -s "https://api.shodan.io/shodan/host/${target}?key=${SHODAN_API_KEY}" 2>/dev/null | jq '{ip:.ip_str,org:.org,os:.os,ports:.ports,hostnames:.hostnames,vulns:.vulns}' 2>/dev/null || echo "[!] No results or API error"
}

check_nvd() {
    local cve="${1:-CVE-2021-44228}"; cve="${cve^^}"
    echo "[*] NVD lookup: $cve"
    curl -s "https://services.nvd.nist.gov/rest/json/cves/2.0?cveId=${cve}" 2>/dev/null | jq '{id:.vulnerabilities[0].cve.id,desc:.vulnerabilities[0].cve.descriptions[0].value,cvss:.vulnerabilities[0].cve.metrics.cvssMetricV31[0].cvssData.baseScore,severity:.vulnerabilities[0].cve.metrics.cvssMetricV31[0].cvssData.baseSeverity}' 2>/dev/null || echo "[!] NVD lookup failed"
}

check_censys() {
    local target="${1:-}"; [[ -z "$CENSYS_UID" ]] && { echo "[!] CENSYS_UID/CENSYS_SECRET not set"; return 1; }
    echo "[*] Censys host lookup: $target"
    curl -s "https://search.censys.io/api/v2/hosts/${target}" -u "${CENSYS_UID}:${CENSYS_SECRET}" 2>/dev/null | jq '{ip:.result.ip,services:.result.services[]?.service_name,ports:.result.services[]?.port}' 2>/dev/null || echo "[!] Censys lookup failed"
}

# Auto-run based on first argument
case "${1:-}" in
    vt|virustotal) check_virustotal "${2:-}" ;;
    shodan)       check_shodan "${2:-}" ;;
    nvd|cve)       check_nvd "${2:-}" ;;
    censys)       check_censys "${2:-}" ;;
esac
EOF
