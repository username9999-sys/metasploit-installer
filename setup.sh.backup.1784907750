    # ──────────────────────────────────────────────────────────────────
    cat > "$D/c2-run.sh" << 'C2REOF'
#!/usr/bin/env bash
# Description: Multi-C2 Launcher — Metasploit, Sliver, Havoc, Mythic
# ==============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/common.sh" 2>/dev/null || true

show_c2_menu() {
    echo -e "\n${RED}${BOLD}=== MULTI-C2 COMMAND CENTER ===${NC}\n"
    echo -e "  ${GREEN}1)${NC} Metasploit  — msfconsole"
    echo -e "  ${GREEN}2)${NC} Sliver      — sliver-client"
    echo -e "  ${GREEN}3)${NC} Havoc       — havoc-client"
    echo -e "  ${GREEN}4)${NC} Mythic      — mythic-cli"
    echo -e "  ${GREEN}5)${NC} Dashboard   — http://localhost:8080"
    echo ""
    local c; read -r -p "  [?] Select C2 (1-5): " c
    case "$c" in
        1)
            cmd_exists msfconsole && msfconsole || { err "msfconsole not installed"; bash "$SCRIPT_DIR/setup-metasploit.sh"; }
            ;;
        2)
            [[ -f "$SCRIPT_DIR/modules/c2/sliver_setup.sh" ]] && bash "$SCRIPT_DIR/modules/c2/sliver_setup.sh"
            ;;
        3)
            [[ -f "$SCRIPT_DIR/modules/c2/havoc_setup.sh" ]] && bash "$SCRIPT_DIR/modules/c2/havoc_setup.sh"
            ;;
        4)
            [[ -f "$SCRIPT_DIR/modules/c2/mythic_setup.sh" ]] && bash "$SCRIPT_DIR/modules/c2/mythic_setup.sh"
            ;;
        5)
            info "Dashboard: http://localhost:8080"
            ;;
        *) warn "Invalid" ;;
    esac
}

case "${1:-}" in
    --c2|--c2-select) shift; show_c2_menu ;;
    menu|"") show_c2_menu ;;
    *) warn "Unknown: $1. Try: bash c2-run.sh"; show_c2_menu ;;
esac
C2REOF

