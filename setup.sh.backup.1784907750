# ──────────────────────────────────────────────────────────────────
# main() — CLI entry point with flag dispatch
# ──────────────────────────────────────────────────────────────────
main() {
    # Load config early for defaults
    load_config

    # Handle flags
    case "${1:-}" in
        --help|-h)
            show_help
            exit 0
            ;;
        --version|-v)
            echo "metasploit-installer v1.0.0"
            exit 0
            ;;
        --full)
            FORCE_MODE=true
            do_full_install
            exit $?
            ;;
        --install)
            FORCE_MODE=true
            load_config
            detect_environment
            create_directory_structure
            populate_all_files
            do_install_metasploit
            install_dashboard
            setup_path
            print_final_banner
            exit $?
            ;;
        --deps)
            load_config
            detect_environment
            do_install_deps
            install_go_tools
            install_python_tools
            exit $?
            ;;
        --check)
            load_config
            detect_environment
            do_preflight_check
            exit $?
            ;;
        --health-check)
            do_health_check
            exit $?
            ;;
        --smoke-test)
            run_smoke_test
            exit $?
            ;;
        --resume)
            resume_skip "populate_all_files" || true
            resume_skip "do_install_deps" || true
            resume_skip "install_go_tools" || true
            resume_skip "install_python_tools" || true
            resume_skip "do_install_metasploit" || true
            do_full_install
            exit $?
            ;;
        --uninstall)
            load_config
            do_uninstall
            exit $?
            ;;
        --clear-cache)
            clear_cache
            exit 0
            ;;
        --dry-run)
            DRY_RUN=true
            info "DRY RUN MODE — no changes will be made"
            load_config
            detect_environment
            do_preflight_check
            exit $?
            ;;
        --force)
            FORCE_MODE=true
            do_full_install
            exit $?
            ;;
        --module)
            shift
            load_config
            detect_environment
            if [[ -n "${1:-}" ]]; then
                bash "$INSTALL_DIR/modules/$1" "${@:2}"
            else
                err "Usage: $0 --module <module_path> [args...]"
                exit 1
            fi
            exit $?
            ;;
        --tmux)
            shift
            bash "$SCRIPT_DIR/scripts/tmux-session.sh" "${@:-pentest}"
            exit $?
            ;;
        --report)
            generate_report
            exit $?
            ;;
        --audit)
            audit_self
            exit $?
            ;;
        --tui|menu|"")
            show_tui_main_menu
            local choice
            read -r -p "  [?] Pilih (0-14): " choice
            case "$choice" in
                1|full) do_full_install ;;
                2|check) do_preflight_check ;;
                3|deps) do_install_deps; install_go_tools; install_python_tools ;;
                4|metasploit) do_install_metasploit; install_dashboard; setup_path ;;
                5|dashboard) install_dashboard ;;
                6|modules) do_browse_modules ;;
                7|cheatsheet) bash "$INSTALL_DIR/cheatsheets/msf-commands.sh" ;;
                8|runbooks) bash "$INSTALL_DIR/runbooks/ad-attack.sh" Corpus corp.local 10.0.0.10 192.168.1.100 2>/dev/null || bash "$INSTALL_DIR/msf-runbooks.sh" ;;
                9|framework) bash "$INSTALL_DIR/msf-pentest-framework.sh" ;;
                10|tmux) bash "$INSTALL_DIR/scripts/tmux-session.sh" ;;
                11|health) do_health_check ;;
                12|report) generate_report ;;
                13|encrypt) encrypt_config ;;
                14|uninstall) do_uninstall ;;
                0|quit) info "Sampai jumpa!"; exit 0 ;;
                *) warn "Pilihan tidak valid" ;;
            esac
            ;;
        *)
            # If first arg looks like a module path, run it
            if [[ "${1:-}" == */* ]]; then
                load_config
                detect_environment
                bash "$INSTALL_DIR/modules/$1" "${@:2}"
                exit $?
            fi
            warn "Unknown command: $1"
            show_help
            exit 1
            ;;
    esac
}

# ──────────────────────────────────────────────────────────────────
# show_help() — Usage information
# ──────────────────────────────────────────────────────────────────
show_help() {
    cat << 'HELP'
metasploit-installer — Master Orchestrator Setup Script

USAGE:
    bash setup.sh [OPTIONS]

    # Zero-config one-click install:
    bash setup.sh --full                    # Full automated installation
    bash setup.sh --install                 # Install Metasploit only (deps assumed)
    bash setup.sh --tui                     # Interactive TUI menu (whiptail)

    # Targeted operations:
    bash setup.sh --deps                    # Install system + Go + Python deps only
    bash setup.sh --check                   # Pre-flight environment check
    bash setup.sh --health-check            # Post-install health check + auto-repair
    bash setup.sh --smoke-test              # Run smoke test on all tools
    bash setup.sh --audit                   # Self-audit all files & dependencies

    # Module execution:
    bash setup.sh --module <category/subcategory/module> [args]
    bash setup.sh scanner/smb/smb_scanner 192.168.1.0/24

    # Maintenance:
    bash setup.sh --resume                  # Resume from last checkpoint
    bash setup.sh --uninstall               # Complete removal
    bash setup.sh --clear-cache             # Clear ~/.cache/metasploit-installer/
    bash setup.sh --dry-run                 # Show what would be done
    bash setup.sh --force                   # Force reinstall (skip idempotency)
    bash setup.sh --tmux [session]          # Launch tmux pentest layout
    bash setup.sh --report                  # Generate system report
    bash setup.sh --help                    # Show this help

CONFIGURATION:
    Edit $INSTALL_DIR/config.env for custom settings:
    INSTALL_DIR=/custom/path                # Default: ~/metasploit-installer
    GITHUB_REPO_URL=https://github.com/...  # Enable auto-push
    AUTO_PUSH=true                          # Auto-git push on install
    SKIP_TOOLS=go,python                    # Skip tool categories
    APT_MIRROR=http://mirror.example.com    # Override APT mirror
    DEBUG_MODE=true                         # Verbose output
    VT_API_KEY=xxx                          # VirusTotal API
    SHODAN_API_KEY=xxx                      # Shodan API
    TELEGRAM_BOT_TOKEN=xxx                  # Telegram notifications
    TELEGRAM_CHAT_ID=xxx

EXAMPLES:
    # Full auto-install (recommended):
    bash setup.sh --full

    # Interactive menu:
    bash setup.sh --tui

    # Run SMB scanner module:
    bash setup.sh --module scanner/smb/smb_scanner 192.168.1.0/24

    # Direct module call:
    bash modules/scanner/smb/smb_scanner.sh 192.168.1.0/24

FILE STRUCTURE AFTER INSTALL:
    $INSTALL_DIR/
    ├── setup.sh                 # This orchestrator
    ├── msf-run.sh               # Module launcher & TUI
    ├── msf-pentest-framework.sh # 5-phase PTES/NIST framework
    ├── msf-runbooks.sh          # AD/Web/Wireless runbooks
    ├── msf-cheatsheet.sh        # Command reference
    ├── msf-ai.sh                # LLM assistant (Ollama/OpenAI)
    ├── c2-run.sh                # Multi-C2 launcher (Sliver/Havoc/Mythic)
    ├── config.env               # Configuration (chmod 600)
    ├── lib/                     # Core libraries
    │   ├── common.sh            # Logging, helpers
    │   ├── env.sh               # OS/user/path detection
    │   ├── checker.sh           # Pre-flight checks
    │   ├── deps.sh              # Dependency installer
    │   ├── root-bridge.sh       # Root/non-root handling
    │   ├── fuzzer.sh            # HTTP fuzzing
    │   ├── validator.sh         # Vuln validation
    │   ├── llm_helper.sh        # AI integration
    │   └── external_api.sh      # VT/Shodan/NVD/Censys
    ├── modules/                 # 25+ modules (scanner/exploit/post/auxiliary)
    ├── runbooks/                # AD attack, Web attack, Emergency breakglass
    ├── cheatsheets/             # MSF commands, Payload generator
    ├── scripts/                 # Daily scan, Report, Forensic wipe, Telegram
    ├── dashboard/               # Flask + Socket.IO web dashboard
    ├── lab/                     # Docker vuln lab (DVWA, Metasploitable)
    ├── collab/                  # Team mode lock file
    └── 06-logs/                 # Audit logs, smoke tests, snapshots

HELP
}

# ──────────────────────────────────────────────────────────────────
# SCRIPT EXECUTION GUARD
# ──────────────────────────────────────────────────────────────────
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi

