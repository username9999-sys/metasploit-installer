#!/usr/bin/env bash
# Description: Dynamic module executor — auto-discovers ALL modules via find
# ==============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"; source "$SCRIPT_DIR/lib/common.sh" 2>/dev/null || true

banner() {
    echo -e "\n${RED}${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}${BOLD}║  METASPLOIT FRAMEWORK — Module Executor & Toolkit           ║${NC}"
    echo -e "${RED}${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}\n"
}

list_available_modules() {
    echo -e "\n${BOLD}Available Modules (auto-discovered):${NC}\n"
    for cat_dir in "$SCRIPT_DIR"/modules/*/; do
        [[ -d "$cat_dir" ]] || continue
        local cat; cat="$(basename "$cat_dir")"
        local count; count=$(find "$cat_dir" -type f -name '*.sh' 2>/dev/null | wc -l)
        echo -e "  ${CYAN}$cat${NC} — $count modules"
        for sub in "$cat_dir"*/; do
            [[ -d "$sub" ]] || continue
            local sub_name; sub_name="$(basename "$sub")"
            for f in "$sub"*.sh; do
                [[ -f "$f" ]] || continue
                local fn; fn="$(basename "$f")"
                local desc; desc=$(head -20 "$f" 2>/dev/null | grep '^# Description:' | head -1 | cut -d: -f2- | sed 's/^ *//')
                [[ -z "$desc" ]] && desc="$(head -3 "$f" | grep '^# ' | head -1 | sed 's/^# *//')"
                echo -e "    ${GREEN}$sub_name/$fn${NC} — ${desc:-module}"
            done
        done
    done
    echo ""
}

run_module() {
    local path="${1:-}"
    [[ -z "$path" ]] && { err "Usage: bash msf-run.sh module <category>/<sub>/<name>"; return 1; }
    # Support: module category/sub/file, modules/category/sub/file.sh, etc.
    local full="$SCRIPT_DIR/modules/$path"
    [[ -f "$full.sh" ]] && full="$full.sh"
    [[ -f "$full" ]] || { full="$SCRIPT_DIR/$path"; }
    [[ -f "$full.sh" ]] && full="$full.sh"
    if [[ -f "$full" ]]; then
        step "Running: $path"
        bash "$full" "${@:2}"
    else
        err "Module not found: $path (tried: $full)"
        info "Browse: bash msf-run.sh modules"
        return 1
    fi
}

case "${1:-menu}" in
    modules|browse|list) list_available_modules ;;
    module) run_module "${2:-}" "${@:3}" ;;
    menu|"")
        banner; echo -e "  ${CYAN}bash msf-run.sh modules${NC}  — Browse all modules"
        echo -e "  ${CYAN}bash msf-run.sh module <path>${NC} — Run specific module"
        echo -e "  ${CYAN}bash msf-run.sh module scanner/smb/smb_scanner 192.168.1.0/24${NC}"; echo "" ;;
    *) run_module "$@" ;;
esac
MRUNEOF

    # ──────────────────────────────────────────────────────────────────
