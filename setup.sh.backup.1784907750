#!/usr/bin/env bash
# Description: AI Pentest Assistant — Ollama/OpenAI powered
# ==============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/llm_helper.sh" 2>/dev/null || {
