    cat > "$D/lib/fuzzer.sh" << 'EOF'
#!/usr/bin/env bash
# Description: HTTP parameter fuzzer — ffuf, wfuzz, gobuster wrapper
set -euo pipefail

fuzz_http_param() {
    local target="${1:-}"; local wordlist="${2:-/usr/share/seclists/Discovery/Web-Content/common.txt}"
    [[ -z "$target" ]] && { echo "Usage: fuzz_http_param <URL> [wordlist]"; return 1; }
    echo -e "\n=== HTTP PARAM FUZZ — $target ===\n"
    echo "[*] ffuf GET param fuzz:"
    echo "  ffuf -u '${target}?FUZZ=1' -w $wordlist -mc 200,301,302,403 -t 50 -o ffuf_params.json"
    echo "[*] ffuf POST data fuzz:"
    echo "  ffuf -u '$target' -X POST -d 'FUZZ=test' -w $wordlist -mc 200,301,302 -t 50"
    echo "[*] wfuzz:"
    echo "  wfuzz -c -z file,$wordlist --hc 404 '${target}?FUZZ=test'"
    echo "[*] gobuster fuzz:"
    echo "  gobuster fuzz -u '$target' -w $wordlist -t 50"
    echo -e "\n=== DONE ===\n"
}

fuzz_http_multipart() {
    local target="${1:-}"; local wordlist="${2:-/usr/share/seclists/Discovery/Web-Content/common.txt}"
    [[ -z "$target" ]] && { echo "Usage: fuzz_http_multipart <URL> [wordlist]"; return 1; }
    echo -e "\n=== MULTIPART FORM FUZZ — $target ===\n"
    echo "[*] ffuf multipart:"
    echo "  ffuf -u '$target' -H 'Content-Type: multipart/form-data' -F 'file=@test.txt' -F 'FUZZ=value' -w $wordlist -t 30"
    echo -e "\n=== DONE ===\n"
}

fuzz_http_headers() {
    local target="${1:-}"; local wordlist="${2:-/usr/share/seclists/Discovery/Web-Content/common.txt}"
    [[ -z "$target" ]] && { echo "Usage: fuzz_http_headers <URL> [wordlist]"; return 1; }
    echo -e "\n=== HTTP HEADER FUZZ — $target ===\n"
    echo "[*] ffuf header fuzz (Host, X-Forwarded-For, etc):"
    echo "  ffuf -u '$target' -H 'FUZZ: test-value' -w $wordlist -mc 200,301,403 -t 50"
    echo "[*] Custom header wordlist:"
    echo "  echo -e 'X-Forwarded-For\nX-Real-IP\nX-Custom-IP-Authorization\nX-Originating-IP\nX-Remote-IP\nX-Client-IP' > headers.txt"
    echo "  ffuf -u '$target' -H 'FUZZ: 127.0.0.1' -w headers.txt -mc 200,403 -t 50"
    echo -e "\n=== DONE ===\n"
}

# Auto-run if args provided
[[ "${1:-}" =~ ^https?:// ]] && fuzz_http_param "$@"
EOF

    cat > "$D/lib/validator.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Vulnerability validator — confirm MS17-010, BlueKeep, HTTP CVEs with 2+ sources
set -euo pipefail
VALIDATED_FILE="${VALIDATED_FILE:-/tmp/validated_findings.json}"

validate_finding() {
    local cve="$1" target="$2"
    local status="UNVERIFIED" evidence=""
    echo -e "\n=== VALIDATE $cve @ $target ===\n"
    case "$cve" in
        MS17-010|ms17-010|CVE-2017-0144)
            echo "[*] Check 1: nmap --script smb-vuln-ms17-010 $target"
            echo "[*] Check 2: msf auxiliary/scanner/smb/smb_ms17_010"
            local nmap_out; nmap_out=$(nmap --script smb-vuln-ms17-010 -p 445 "$target" 2>/dev/null || echo "")
            if echo "$nmap_out" | grep -qi "VULNERABLE"; then
                status="CONFIRMED"; evidence="nmap SMB vuln scan returned VULNERABLE"
            else
                status="FALSE_POSITIVE"; evidence="nmap did not confirm vulnerability"
            fi
            ;;
        BlueKeep|bluekeep|CVE-2019-0708)
            echo "[*] Check 1: nmap --script rdp-vuln-ms12-020 -p 3389 $target"
            echo "[*] Check 2: msf auxiliary/scanner/rdp/cve_2019_0708_bluekeep"
            local rdp_out; rdp_out=$(nmap --script rdp-vuln-ms12-020 -p 3389 "$target" 2>/dev/null || echo "")
            if echo "$rdp_out" | grep -qi "VULNERABLE"; then
                status="CONFIRMED"; evidence="nmap RDP vuln scan returned VULNERABLE"
            else
                status="FALSE_POSITIVE"; evidence="nmap did not confirm"
            fi
            ;;
        *)
            echo "[*] Generic CVE check via nuclei:"
            echo "  nuclei -u $target -id $cve -severity critical,high"
            local nuc_out; nuc_out=$(nuclei -u "$target" -id "$cve" -silent -jsonl 2>/dev/null || echo "")
            if [[ -n "$nuc_out" ]]; then
                status="CONFIRMED"; evidence="$nuc_out"
            else
                status="NEEDS_MANUAL"; evidence="nuclei returned no match — manual verification required"
            fi
            ;;
    esac
    echo "{\"cve\":\"$cve\",\"target\":\"$target\",\"status\":\"$status\",\"evidence\":\"$evidence\",\"timestamp\":\"$(date -Iseconds)\"}" >> "$VALIDATED_FILE"
    echo "[*] Result: $status"
}

[[ "${1:-}" =~ ^(MS17|BlueKeep|CVE-) ]] && validate_finding "$1" "${2:-127.0.0.1}"
EOF

