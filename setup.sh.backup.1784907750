    cat > "$D/scripts/forensic_wipe.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Forensic wipe — secure delete artifacts, clear logs, remove traces
# ⚠️ ONLY for authorized engagements with explicit cleanup permission
set -euo pipefail
TARGET_USER="${1:-}"; WORK_DIR="${2:-/tmp}"

echo -e "\033[1;31m"
echo "╔══════════════════════════════════════════════════════════════════╗"
echo "║  ⚠️  FORENSIC WIPE — AUTHORIZED CLEANUP ONLY                     ║"
echo "║  This script removes ALL traces of pentest activity.             ║"
echo "║  Requires EXPLICIT permission in Rules of Engagement.            ║"
echo "╚══════════════════════════════════════════════════════════════════╝"
echo -e "\033[0m"

echo "[*] Step 1: Clear shell histories..."
for f in "$HOME/.bash_history" "$HOME/.zsh_history" "$HOME/.mysql_history" "$HOME/.psql_history" "$HOME/.python_history" "$HOME/.node_repl_history"; do
    [[ -f "$f" ]] && { shred -uz "$f" 2>/dev/null && echo "  [✓] $f" || echo "  [!] $f (rewrite with /dev/null)"; > "$f" 2>/dev/null; }
done

echo "[*] Step 2: Remove temporary files..."
for d in /tmp /var/tmp "$WORK_DIR"; do
    find "$d" -type f \( -name '*.exe' -o -name '*.elf' -o -name '*.ps1' -o -name 'meterpreter*' -o -name 'payload*' \) -user "$(whoami)" -exec shred -uz {} \; 2>/dev/null && echo "  [✓] Cleaned $d"
done

echo "[*] Step 3: Clear system logs (requires sudo)..."
if command -v sudo &>/dev/null && sudo -n true 2>/dev/null; then
    sudo journalctl --rotate 2>/dev/null; sudo journalctl --vacuum-time=1s 2>/dev/null
    for log in /var/log/auth.log /var/log/syslog /var/log/messages /var/log/secure; do
        [[ -f "$log" ]] && sudo truncate -s 0 "$log" 2>/dev/null && echo "  [✓] $log"
    done
else
    echo "  [!] No sudo — system logs preserved"
fi

echo "[*] Step 4: Clear msfconsole database..."
msfconsole -q -x "workspace -D; exit;" 2>/dev/null && echo "  [✓] MSF DB dropped" || echo "  [!] msfconsole not active"

echo "[*] Step 5: Remove Metasploit artifacts..."
rm -rf "$HOME/.msf4/logs" "$HOME/.msf4/loot" "$HOME/.msf4/local" 2>/dev/null
echo "  [✓] MSF artifacts removed"

echo "[*] Step 6: Clear browser artifacts..."
for b in "$HOME/.mozilla/firefox" "$HOME/.config/google-chrome" "$HOME/.config/chromium"; do
    [[ -d "$b" ]] && { find "$b" -name 'Cookies*' -o -name 'History*' -o -name 'Web Data*' -exec shred -uz {} \; 2>/dev/null; echo "  [✓] $b cleared"; }
done

echo "[*] Step 7: Memory cleanup note..."
echo "  Reboot recommended to clear in-memory artifacts"
echo "  Consider: swapoff -a && swapon -a to clear swap"

echo -e "\n=== FORENSIC WIPE COMPLETE ===\n"
EOF

