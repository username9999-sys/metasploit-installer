[[ -z "$question" ]] && {
    echo "Examples:"
    echo "  bash msf-ai.sh 'How to privesc on Linux kernel 5.10?'"
    echo "  bash msf-ai.sh 'Best EternalBlue alternatives if patched?'"
    echo "  bash msf-ai.sh 'How to pivot from DMZ to internal network?'"
