#!/usr/bin/env bash
# ==============================================================================
#  METASPLOIT-INSTALLER MASTER ORCHESTRATOR — setup.sh v3.0 Enterprise-Pro
#  Single-script full-stack deployment: 30+ modules, 18 premium features
# ==============================================================================
set -euo pipefail; IFS=$'\n\t'

# ── Colors ──────────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'
MAGENTA='\033[0;35m'; CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'

# ── Global State ────────────────────────────────────────────────────────────────
SCRIPT_START_TIME=$(date +%s)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_NAME="$(basename "${BASH_SOURCE[0]}")"
_BG_PIDS=(); _SPINNER_PID=""; DRY_RUN=false; FORCE_MODE=false
SELF_UPDATED=false; _INSTALL_PHASE="init"

# ── Logging ─────────────────────────────────────────────────────────────────────
log()   { echo -e "  ${GREEN}[✓]${NC} $(date +%H:%M:%S) $*"; }
info()  { echo -e "  ${BLUE}[*]${NC} $*"; }
warn()  { echo -e "  ${YELLOW}[!]${NC} $*" >&2; }
err()   { echo -e "  ${RED}[✗]${NC} $*" >&2; }
step()  { echo -e "\n${CYAN}${BOLD}═══ $* ═══${NC}\n"; }
title() { echo -e "${MAGENTA}${BOLD}$*${NC}"; }
banner_box() {
    echo -e "\n${RED}${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}${BOLD}║  METASPLOIT INSTALLER — Enterprise Master Orchestrator v3.0 ║${NC}"
    echo -e "${RED}${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}\n"
}

# ── Trap ────────────────────────────────────────────────────────────────────────
on_exit() {
    local ec=$?
    for p in "${_BG_PIDS[@]:-}"; do kill "$p" 2>/dev/null || true; done
    [[ -n "${_SPINNER_PID:-}" ]] && kill "$_SPINNER_PID" 2>/dev/null || true
    if [[ $ec -ne 0 && $ec -ne 130 ]]; then
        err "Exit code $ec at line ${BASH_LINENO[0]:-?}: ${BASH_COMMAND:-unknown}"
    fi
}
trap on_exit EXIT; trap 'echo -e "\n${YELLOW}[!] SIGINT${NC}"; exit 130' INT
trap 'echo -e "\n${YELLOW}[!] SIGTERM${NC}"; exit 143' TERM

# ── Helpers ─────────────────────────────────────────────────────────────────────
cmd_exists() { command -v "$1" &>/dev/null; }
is_root() { [[ "${EUID:-$(id -u)}" -eq 0 ]]; }
has_sudo() { cmd_exists sudo && sudo -n true 2>/dev/null; }
user_mode() { is_root && echo "root" || { has_sudo && echo "sudo" || echo "normal"; }; }
priv_run() {
    local cmd="$1"
    case "$(user_mode)" in root) eval "$cmd" ;; sudo) eval "sudo $cmd" ;;
        normal) eval "$cmd" 2>/dev/null || { warn "Need sudo for: $cmd"; return 1; } ;; esac
}
ask_yesno() {
    local prompt="${1:-Continue?}" d="${2:-y}"; $FORCE_MODE && return 0
    local h; [[ "$d" == "y" ]] && h="[Y/n]" || h="[y/N]"
    local a; read -r -p "  [?] $prompt $h: " a; a="${a:-$d}"
    [[ "${a,,}" == "y" || "${a,,}" == "yes" ]]
}

# ── Spinner ─────────────────────────────────────────────────────────────────────
spinner() { local pid=$1 m="${2:-Working}"; local s="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    while kill -0 "$pid" 2>/dev/null; do for ((i=0;i<${#s};i++)); do
        printf "\r  ${BLUE}%s${NC} %s" "${s:$i:1}" "$m"; sleep 0.1; done; done
    printf "\r  ${GREEN}✓${NC} %s Done\n" "$m"; }

# ── Progress file helpers ───────────────────────────────────────────────────────
mark_done() { echo "[DONE] $(date +%H:%M:%S) $1" >> "${PROGRESS_FILE:-/dev/null}" 2>/dev/null || true; }
is_done() { [[ -f "${PROGRESS_FILE:-}" ]] && grep -qF "[DONE] $1" "$PROGRESS_FILE" 2>/dev/null; }

# ── Timer ───────────────────────────────────────────────────────────────────────
elapsed() { echo "$(($(date +%s) - SCRIPT_START_TIME))s"; }

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  CONFIG SYSTEM (.env)                                                       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

DEFAULT_INSTALL_DIR="$HOME/metasploit-installer"
CONFIG_FILE=""
GITHUB_REPO_URL=""
SKIP_TOOLS=""
APT_MIRROR=""
AUTO_PUSH=false
DEBUG_MODE=false

load_config() {
    CONFIG_FILE="${INSTALL_DIR:-$DEFAULT_INSTALL_DIR}/config.env"
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck disable=SC1090
        set +x; source "$CONFIG_FILE" 2>/dev/null || warn "Config parse partial"; set -x 2>/dev/null || true
        INSTALL_DIR="${INSTALL_DIR:-$DEFAULT_INSTALL_DIR}"
        GITHUB_REPO_URL="${GITHUB_REPO_URL:-}"
        SKIP_TOOLS="${SKIP_TOOLS:-}"
        APT_MIRROR="${APT_MIRROR:-}"
        AUTO_PUSH="${AUTO_PUSH:-false}"
        DEBUG_MODE="${DEBUG_MODE:-false}"
        info "Config loaded: $CONFIG_FILE"
    else
        info "No config.env found — will create defaults"
    fi
    export INSTALL_DIR GITHUB_REPO_URL SKIP_TOOLS APT_MIRROR AUTO_PUSH DEBUG_MODE
}

create_default_config() {
    local cfg="$INSTALL_DIR/config.env"
    $DRY_RUN && { info "DRY-RUN: would write $cfg"; return 0; }
    mkdir -p "$INSTALL_DIR" 2>/dev/null || true
    cat > "$cfg" << CFGEOF
# ==============================================================================
# metasploit-installer CONFIGURATION
# ==============================================================================
# Edit these variables BEFORE running setup.sh --full
# Lines starting with # are comments

# Installation directory (where the project is built)
INSTALL_DIR="${INSTALL_DIR:-$HOME/metasploit-installer}"

# GitHub repo URL (leave empty to skip push, or set for auto-push)
GITHUB_REPO_URL=""

# Skip specific tool groups (comma-separated: go,python,ruby,nmap)
SKIP_TOOLS=""

# APT package mirror (empty = default, or e.g. http://id.archive.ubuntu.com/ubuntu)
APT_MIRROR=""

# Auto-push to GitHub after setup (true/false)
AUTO_PUSH=false

# Debug mode (true = verbose output)
DEBUG_MODE=false

# Checksums (optional — populate for binary verification)
CHECKSUM_NMAP=""
CHECKSUM_METASPLOIT=""
CFGEOF
    chmod 600 "$cfg"
    log "Created: $cfg (chmod 600)"
}

encrypt_config() {
    local cfg="$INSTALL_DIR/config.env"
    [[ ! -f "$cfg" ]] && { err "No config.env to encrypt"; return 1; }
    if ! cmd_exists openssl; then
        warn "openssl not found — installing..."
        priv_run "apt-get install -y openssl" 2>/dev/null || { err "Cannot install openssl"; return 1; }
    fi
    read -r -s -p "  [?] Encryption password: " ENC_PASS
    echo ""
    read -r -s -p "  [?] Confirm password: " ENC_CONF
    echo ""
    [[ "$ENC_PASS" != "$ENC_CONF" ]] && { err "Passwords do not match"; return 1; }
    openssl aes-256-cbc -salt -pbkdf2 -in "$cfg" -out "${cfg}.enc" -pass pass:"$ENC_PASS" 2>/dev/null || {
        err "Encryption failed"; return 1
    }
    shred -u "$cfg" 2>/dev/null || rm -f "$cfg"
    log "Config encrypted → ${cfg}.enc (original shredded)"
    warn "Save your password securely — it cannot be recovered"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  ENVIRONMENT DETECTION (OS / ARCH / DISTRO / PROXY)                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

detect_environment() {
    export ARCH="$(uname -m)"
    export OS_TYPE; case "$(uname -s)" in Linux) OS_TYPE="linux" ;; Darwin) OS_TYPE="macos" ;; *) OS_TYPE="other" ;; esac

    # Distro
    export DISTRO_ID DISTRO_VERSION DISTRO_FAMILY PACKAGE_MANAGER PKG_INSTALL
    if [[ -f /etc/os-release ]]; then source /etc/os-release 2>/dev/null || true; DISTRO_ID="${ID,,}"; DISTRO_VERSION="${VERSION_ID:-}"
    elif [[ -f /etc/arch-release ]]; then DISTRO_ID="arch"
    elif cmd_exists termux-info 2>/dev/null; then DISTRO_ID="termux"
    else DISTRO_ID="unknown"; fi

    case "$DISTRO_ID" in
        ubuntu|debian|kali|parrot|linuxmint|pop|raspbian|zorin) DISTRO_FAMILY="debian"; PACKAGE_MANAGER="apt"; PKG_INSTALL="sudo apt-get install -y --no-install-recommends"; PKG_UPDATE="sudo apt-get update -qq" ;;
        fedora|rhel|centos|rocky|alma|oracle) DISTRO_FAMILY="redhat"; PACKAGE_MANAGER="dnf"; PKG_INSTALL="sudo dnf install -y"; PKG_UPDATE="" ;;
        arch|manjaro|endeavouros|garuda) DISTRO_FAMILY="arch"; PACKAGE_MANAGER="pacman"; PKG_INSTALL="sudo pacman -Sy --noconfirm --needed"; PKG_UPDATE="sudo pacman -Sy --noconfirm" ;;
        opensuse*|sles) DISTRO_FAMILY="suse"; PACKAGE_MANAGER="zypper"; PKG_INSTALL="sudo zypper install -y"; PKG_UPDATE="" ;;
        termux) DISTRO_FAMILY="termux"; PACKAGE_MANAGER="pkg"; PKG_INSTALL="pkg install -y"; PKG_UPDATE="pkg update -qq" ;;
        *) DISTRO_FAMILY="unknown"; PACKAGE_MANAGER=""; PKG_INSTALL=""; PKG_UPDATE="" ;;
    esac

    # Architecture bin mapping
    case "$ARCH" in
        x86_64|amd64) export BIN_ARCH="amd64"; export GO_ARCH="amd64" ;;
        aarch64|arm64) export BIN_ARCH="arm64"; export GO_ARCH="arm64" ;;
        armv7l|arm) export BIN_ARCH="arm"; export GO_ARCH="armv6l" ;;
        *) export BIN_ARCH="$ARCH"; export GO_ARCH="$ARCH"; warn "Unknown arch: $ARCH — using as-is" ;;
    esac

    # User
    export CURRENT_USER="$(whoami)"; export HOME_DIR="$HOME"; export USER_MODE="$(user_mode)"

    # Proxy detection
    export HTTP_PROXY="${http_proxy:-${HTTP_PROXY:-}}"; export HTTPS_PROXY="${https_proxy:-${HTTPS_PROXY:-}}"
    [[ -n "$HTTP_PROXY" ]] && { info "HTTP proxy detected: $HTTP_PROXY"; git config --global http.proxy "$HTTP_PROXY" 2>/dev/null || true; }
    [[ -n "$HTTPS_PROXY" ]] && { info "HTTPS proxy detected: $HTTPS_PROXY"; git config --global https.proxy "$HTTPS_PROXY" 2>/dev/null || true; }

    # APT mirror override
    if [[ -n "${APT_MIRROR:-}" ]] && [[ "$DISTRO_FAMILY" == "debian" ]]; then
        info "APT mirror override: $APT_MIRROR"
        $DRY_RUN || priv_run "sed -i 's|http://archive.ubuntu.com/ubuntu|${APT_MIRROR}|g' /etc/apt/sources.list 2>/dev/null || true"
    fi

    info "Env: $OS_TYPE/$DISTRO_ID/$DISTRO_FAMILY arch=$ARCH user=$CURRENT_USER mode=$USER_MODE"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  CACHE SYSTEM (~/.cache/metasploit-installer/)                              ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

CACHE_DIR="${HOME}/.cache/metasploit-installer"

init_cache() { mkdir -p "$CACHE_DIR" 2>/dev/null || true; }

cache_get() {
    local file="$1" hash="${2:-}"
    local cpath="$CACHE_DIR/$file"
    [[ -f "$cpath" ]] || return 1
    if [[ -n "$hash" ]]; then
        local actual; actual=$(sha256sum "$cpath" 2>/dev/null | awk '{print $1}')
        [[ "$actual" == "$hash" ]] || { warn "Cached $file hash mismatch — re-download"; return 1; }
    fi
    cp "$cpath" . 2>/dev/null || ln "$cpath" . 2>/dev/null || return 1
    log "Using cached: $file"
    return 0
}

cache_store() { local f="$1"; cp "$f" "$CACHE_DIR/" 2>/dev/null || true; info "Cached: $f"; }

clear_cache() {
    step "Clearing Cache"
    if [[ -d "$CACHE_DIR" ]]; then
        rm -rf "$CACHE_DIR" && log "Cache cleared: $CACHE_DIR" || err "Failed to clear cache"
    else info "No cache to clear"; fi
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  SELF-UPDATE (git fetch → compare → pull → exec)                            ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

self_update() {
    [[ "$SELF_UPDATED" == "true" ]] && return 0
    if [[ -d "$SCRIPT_DIR/.git" ]]; then
        info "Checking for updates..."
        cd "$SCRIPT_DIR"
        git fetch origin main 2>/dev/null || { warn "Cannot fetch — no remote or no network"; return 0; }
        local local_hash; local_hash=$(git rev-parse HEAD 2>/dev/null || echo "")
        local remote_hash; remote_hash=$(git rev-parse origin/main 2>/dev/null || echo "")
        if [[ "$local_hash" != "$remote_hash" && -n "$remote_hash" ]]; then
            info "Update available — pulling..."
            git pull origin main 2>/dev/null || { warn "Pull failed"; return 0; }
            log "Updated to $remote_hash — restarting..."
            exec bash "$0" --updated "${@}"
            exit 0
        else
            log "Already up-to-date"
        fi
        cd - >/dev/null
    fi
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  CHECKPOINT & RESUME                                                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

init_checkpoint() {
    PROGRESS_FILE="$INSTALL_DIR/.progress"
    $DRY_RUN && { info "DRY-RUN: progress file virtual"; return 0; }
    if [[ -f "$PROGRESS_FILE" ]]; then
        if is_done "full_install"; then
            warn "Full install already completed per progress file"
            ask_yesno "Re-run anyway?" "n" || { info "Use --force to override"; exit 0; }
            rm -f "$PROGRESS_FILE"
        elif $DO_RESUME; then
            log "Resume mode: will skip completed phases"
        else
            warn "Partial progress detected — use --resume to continue"
            info "Completed phases:"
            grep '^\[DONE\]' "$PROGRESS_FILE" 2>/dev/null | while read -r line; do
                echo "    $line"
            done
            ask_yesno "Start fresh?" "y" || {
                info "Re-run with --resume"; exit 0
            }
            rm -f "$PROGRESS_FILE"
        fi
    fi
    echo "# metasploit-installer progress — $(date -Iseconds)" > "$PROGRESS_FILE"
}

resume_skip() {
    local phase="$1"
    if [[ -f "${PROGRESS_FILE:-}" ]] && grep -qF "[DONE] $phase" "$PROGRESS_FILE" 2>/dev/null; then
        log "Skipping completed phase: $phase"
        return 0
    fi
    return 1
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  SYSTEM SNAPSHOT (PRE/POST DIFF) — FEATURE 17                               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

SNAP_PRE="/tmp/msf-installer-snap-pre-$$.txt"
SNAP_POST="/tmp/msf-installer-snap-post-$$.txt"

take_snapshot() {
    local out="$1"
    echo "=== SNAPSHOT $(date -Iseconds) ===" > "$out"
    echo "--- dpkg -l ---" >> "$out"
    dpkg -l 2>/dev/null >> "$out" || rpm -qa 2>/dev/null >> "$out" || true
    echo "--- /usr/local/bin ---" >> "$out"
    ls -la /usr/local/bin/ 2>/dev/null >> "$out" || true
    echo "--- processes ---" >> "$out"
    ps aux --no-headers 2>/dev/null | head -50 >> "$out" || true
    echo "--- PATH ---" >> "$out"
    echo "$PATH" >> "$out"
}

diff_snapshots() {
    local diff_out="$INSTALL_DIR/audit_diff.log"
    step "System Audit Diff"
    mkdir -p "$(dirname "$diff_out")" 2>/dev/null || true
    if diff "$SNAP_PRE" "$SNAP_POST" > "$diff_out" 2>/dev/null; then
        log "No system changes detected (clean install?)"
    else
        warn "Changes detected — saved to audit_diff.log"
        info "Summary: $(grep -c '^>' "$diff_out" 2>/dev/null || echo 0) lines added, $(grep -c '^<' "$diff_out" 2>/dev/null || echo 0) removed"
        echo "See: $diff_out"
    fi
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  WHIPTAIL TUI MENUS (with text fallback)                                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

HAS_WHIPTAIL=false; cmd_exists whiptail && HAS_WHIPTAIL=true

whiptail_menu() {
    local title="$1" text="$2" height="$3" width="$4" menu_height="$5"
    shift 5
    if $HAS_WHIPTAIL && [[ -n "${TERM:-}" && "$TERM" != "dumb" ]]; then
        whiptail --title "$title" --menu "$text" "$height" "$width" "$menu_height" "$@" 2>&1
    else
        echo ""
        echo -e "${CYAN}${BOLD}$title${NC}"
        echo "$text"
        echo ""
        local i=1; local tags=("$@")
        for ((i=0; i<${#tags[@]}; i+=3)); do
            echo -e "  ${GREEN}${tags[$i]}${NC}) ${tags[$i+1]}"
        done
        echo ""
        read -r -p "  [?] Choice: " choice; echo "$choice"
    fi
}

whiptail_gauge() {
    local title="$1" text="$2" pct="$3"
    if $HAS_WHIPTAIL && [[ -n "${TERM:-}" && "$TERM" != "dumb" ]]; then
        whiptail --title "$title" --gauge "$text" 8 70 "$pct" 2>/dev/null
    else
        info "$text ($pct%)"
    fi
}

show_tui_main_menu() {
    local choice
    choice=$(whiptail_menu \
        "Metasploit Installer — Main Menu" \
        "Select an action:" \
        22 76 14 \
        "full"      "🚀 Full Installation (all components)" \
        "check"     "🔍 Pre-flight System Check" \
        "deps"      "📦 Install Dependencies Only" \
        "modules"   "📁 Browse & Run Modules" \
        "install"   "⚙️  Install Metasploit Framework" \
        "cheatsheet" "📖 View Cheatsheets" \
        "runbooks"  "📋 View Attack Runbooks" \
        "framework" "🧠 Pentest Framework (5 Phases)" \
        "tmux"      "🖥️  Create Tmux Pentest Session" \
        "health"    "🏥 Health Check & Auto-Repair" \
        "report"    "📊 Generate System Report" \
        "encrypt"   "🔐 Encrypt config.env" \
        "uninstall" "🗑️  Uninstall Everything" \
        "quit"      "👋 Exit")
    case "$choice" in
        full)      do_full_install ;;
        check)     do_preflight_check ;;
        deps)      do_install_deps ;;
        modules)   do_browse_modules ;;
        install)   do_install_metasploit ;;
        cheatsheet) do_show_cheatsheets ;;
        runbooks)  do_show_runbooks ;;
        framework) do_show_framework ;;
        tmux)      create_tmux_session ;;
        health)    do_health_check ;;
        report)    generate_report ;;
        encrypt)   encrypt_config ;;
        uninstall) do_uninstall ;;
        quit|"")   info "Goodbye!"; exit 0 ;;
        *) warn "Invalid choice"; show_tui_main_menu ;;
    esac
}


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  FEATURE 7: CHECKSUM VERIFICATION                                           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

verify_checksum() {
    local file="$1" expected_hash="${2:-}" label="${3:-binary}"
    [[ -z "$expected_hash" ]] && { warn "No checksum defined for $label — skipping verification"; return 0; }
    [[ ! -f "$file" ]] && { err "$file not found for checksum"; return 5; }
    local actual; actual=$(sha256sum "$file" 2>/dev/null | awk '{print $1}')
    if [[ "$actual" != "$expected_hash" ]]; then
        err "CHECKSUM MISMATCH for $label!"
        err "  Expected: $expected_hash"
        err "  Got:      $actual"
        err "  File:     $file"
        return 5
    fi
    log "Checksum verified: $label"
    return 0
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  FEATURE 8: PARALLEL INSTALLATION ENGINE                                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

parallel_run() {
    local -a pids=()
    local -a labels=()
    local total=0 completed=0
    echo ""
    info "Launching parallel jobs..."
    for job in "$@"; do
        IFS='|' read -r label cmd <<< "$job"
        labels+=("$label"); total=$((total + 1))
        info "  Starting: $label"
        (eval "$cmd" &>/tmp/msf-parallel-$$-${total}.log && echo "OK" > "/tmp/msf-parallel-$$-${total}.status" || echo "FAIL" > "/tmp/msf-parallel-$$-${total}.status") &
        pids+=($!)
    done

    info "Waiting for $total jobs..."
    for idx in "${!pids[@]}"; do
        local pid="${pids[$idx]}"; local label="${labels[$idx]}"
        while kill -0 "$pid" 2>/dev/null; do sleep 2; done
        wait "$pid" 2>/dev/null; local ec=$?
        completed=$((completed + 1))
        local pct=$(( completed * 100 / total ))
        whiptail_gauge "Parallel Install" "Completed: $label ($completed/$total)" "$pct"
        if [[ $ec -eq 0 ]] && grep -q "OK" "/tmp/msf-parallel-$$-$((idx+1)).status" 2>/dev/null; then
            log "$label done ($completed/$total)"
        else
            warn "$label FAILED ($completed/$total) — check /tmp/msf-parallel-$$-$((idx+1)).log"
        fi
    done
    rm -f /tmp/msf-parallel-$$-*.{log,status} 2>/dev/null || true
    log "All parallel jobs completed"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  DEPENDENCY INSTALLER                                                       ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

install_system_deps() {
    resume_skip "system_deps" && return 0
    step "System Package Installation"
    if [[ "$DISTRO_FAMILY" != "debian" && "$DISTRO_FAMILY" != "redhat" && "$DISTRO_FAMILY" != "arch" && "$DISTRO_FAMILY" != "termux" ]]; then
        err "Unsupported distro: $DISTRO_ID ($DISTRO_FAMILY)"
        info "Supported: Debian/Ubuntu/Kali, Fedora/RHEL, Arch, Termux"
        ask_yesno "Try anyway?" "n" || exit 1
    fi

    $DRY_RUN && { info "DRY-RUN: would install system packages"; return 0; }

    [[ -n "${PKG_UPDATE:-}" ]] && { info "Updating repos..."; $PKG_UPDATE 2>/dev/null || warn "Repo update failed"; }

    local PKGS="build-essential autoconf bison make git curl wget libssl-dev libpcap-dev libpq-dev libsqlite3-dev zlib1g-dev libreadline-dev libffi-dev libgmp-dev libxml2-dev libxslt1-dev gpgv2 apt-transport-https software-properties-common ruby ruby-dev postgresql postgresql-contrib nmap enum4linux sqlmap hydra crackmapexec impacket-scripts bloodhound tmux tree jq python3 python3-pip pipx golang-go nikto dirb wpscan arp-scan"

    # Adjust per distro
    case "$DISTRO_FAMILY" in
        redhat) PKGS="gcc gcc-c++ make autoconf bison git curl wget openssl-devel libpcap-devel libpq-devel sqlite-devel zlib-devel readline-devel libffi-devel gmp-devel libxml2-devel libxslt-devel ruby ruby-devel postgresql postgresql-server postgresql-devel nmap sqlmap hydra crackmapexec bloodhound tmux tree jq python3 python3-pip pipx golang nikto dirb wpscan arp-scan" ;;
        arch) PKGS="base-devel autoconf bison make git curl wget openssl libpcap postgresql-libs sqlite zlib readline libffi gmp libxml2 libxslt ruby postgresql nmap sqlmap hydra crackmapexec bloodhound tmux tree jq python python-pip python-pipx go nikto dirb wpscan arp-scan" ;;
        termux) PKGS="clang make binutils autoconf bison git curl wget openssl libpcap postgresql sqlite zlib readline libffi gmp libxml2 libxslt ruby postgresql nmap python python-pip hydra tmux tree jq golang" ;;
    esac

    info "Installing: $PKGS"
    if $PKG_INSTALL $PKGS 2>&1 | tail -30; then
        log "All system packages installed"
    else
        warn "Batch failed — installing individually..."
        for pkg in $PKGS; do
            info "  Trying: $pkg"
            $PKG_INSTALL "$pkg" 2>/dev/null && log "  $pkg ✓" || warn "  $pkg ✗ (skipped)"
        done
    fi
    mark_done "system_deps"
}

install_go_tools() {
    resume_skip "go_tools" && return 0
    step "Go Security Tools (parallel)"
    if [[ -n "${SKIP_TOOLS:-}" ]] && echo "$SKIP_TOOLS" | grep -q "go"; then
        warn "Skipping Go tools (SKIP_TOOLS=go)"
        return 0
    fi

    ensure_go() {
        cmd_exists go || {
            info "Installing Go..."
            case "$DISTRO_FAMILY" in
                debian) priv_run "apt-get install -y golang-go" ;;
                redhat) priv_run "dnf install -y golang" ;;
                arch) priv_run "pacman -Sy --noconfirm go" ;;
                termux) pkg install -y golang ;;
                *)
                    local go_url="https://go.dev/dl/go1.22.0.linux-${GO_ARCH}.tar.gz"
                    info "Downloading Go from $go_url"
                    curl -fsSL "$go_url" -o /tmp/go.tar.gz
                    priv_run "rm -rf /usr/local/go && tar -C /usr/local -xzf /tmp/go.tar.gz"
                    export PATH="$PATH:/usr/local/go/bin"
                    ;;
            esac
        }
        export PATH="$HOME/go/bin:$PATH"
        mkdir -p "$HOME/go/bin"
    }
    ensure_go

    $DRY_RUN && { info "DRY-RUN: would install go tools"; return 0; }

    local GO_TOOLS=(
        "subfinder|go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest"
        "httpx|go install -v github.com/projectdiscovery/httpx/cmd/httpx@latest"
        "nuclei|go install -v github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest"
        "assetfinder|go install -v github.com/tomnomnom/assetfinder@latest"
        "waybackurls|go install -v github.com/tomnomnom/waybackurls@latest"
        "gau|go install -v github.com/lc/gau/v2/cmd/gau@latest"
        "qsreplace|go install -v github.com/tomnomnom/qsreplace@latest"
        "dalfox|go install -v github.com/hahwul/dalfox/v2@latest"
        "ParamSpider|go install -v github.com/0xKayala/ParamSpider@latest"
    )

    parallel_run "${GO_TOOLS[@]}"
    mark_done "go_tools"
}

install_python_tools() {
    resume_skip "python_tools" && return 0
    step "Python Security Tools (pipx parallel)"
    if [[ -n "${SKIP_TOOLS:-}" ]] && echo "$SKIP_TOOLS" | grep -q "python"; then
        warn "Skipping Python tools (SKIP_TOOLS=python)"
        return 0
    fi
    $DRY_RUN && { info "DRY-RUN: would install python tools"; return 0; }

    cmd_exists pipx || {
        info "Installing pipx..."
        priv_run "apt-get install -y pipx" 2>/dev/null || python3 -m pip install --user pipx 2>/dev/null || true
    }
    pipx ensurepath 2>/dev/null || true
    export PATH="$HOME/.local/bin:$PATH"

    local PY_TOOLS=(
        "impacket|pipx install impacket 2>/dev/null || python3 -m pip install --user impacket"
        "evil-winrm|pipx install evil-winrm 2>/dev/null || gem install evil-winrm 2>/dev/null || true"
        "mitm6|pipx install mitm6 2>/dev/null || python3 -m pip install --user mitm6"
        "responder|pipx install responder 2>/dev/null || python3 -m pip install --user responder"
    )

    parallel_run "${PY_TOOLS[@]}"
    mark_done "python_tools"
}

do_install_deps() {
    install_system_deps
    install_go_tools
    install_python_tools
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  DIRECTORY CREATION                                                        ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

create_directory_structure() {
    resume_skip "dirs_created" && return 0
    step "Creating Directory Structure"
    local dirs=(
        "$INSTALL_DIR/cheatsheets"
        "$INSTALL_DIR/lib"
        "$INSTALL_DIR/modules/auxiliary/dos"
        "$INSTALL_DIR/modules/auxiliary/fuzzers"
        "$INSTALL_DIR/modules/auxiliary/spoof"
        "$INSTALL_DIR/modules/evasion"
        "$INSTALL_DIR/modules/cloud"
        "$INSTALL_DIR/modules/container"
        "$INSTALL_DIR/modules/exploit/linux"
        "$INSTALL_DIR/modules/exploit/multi"
        "$INSTALL_DIR/modules/exploit/windows"
        "$INSTALL_DIR/modules/gather/dns"
        "$INSTALL_DIR/modules/gather/email"
        "$INSTALL_DIR/modules/gather/web"
        "$INSTALL_DIR/modules/post/linux"
        "$INSTALL_DIR/modules/post/persistence"
        "$INSTALL_DIR/modules/post/windows"
        "$INSTALL_DIR/modules/scanner/http"
        "$INSTALL_DIR/modules/scanner/network"
        "$INSTALL_DIR/modules/scanner/smb"
        "$INSTALL_DIR/modules/scanner/ssh"
        "$INSTALL_DIR/modules/scanner/ssl"
        "$INSTALL_DIR/modules/scanner/vuln"
        "$INSTALL_DIR/runbooks"
        "$INSTALL_DIR/setup"
    )
    $DRY_RUN && { info "DRY-RUN: would create ${#dirs[@]} directories"; return 0; }
    for d in "${dirs[@]}"; do
        mkdir -p "$d" && info "  $d" || { err "Failed: mkdir $d"; return 1; }
    done
    log "${#dirs[@]} directories created"
    mark_done "dirs_created"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  IDEMPOTENCY CHECK                                                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

check_idempotency() {
    if [[ -d "$INSTALL_DIR" ]] && [[ "$(ls -A "$INSTALL_DIR" 2>/dev/null | wc -l)" -gt 3 ]]; then
        warn "Install directory $INSTALL_DIR already has content"
        if ! $FORCE_MODE; then
            if ask_yesno "Backup existing & start fresh?" "y"; then
                local bak="$INSTALL_DIR.bak.$(date +%s)"
                mv "$INSTALL_DIR" "$bak" && log "Backed up to: $bak"
            else
                info "Continuing in-place (may overwrite)"
            fi
        fi
    fi
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  PRE-FLIGHT CHECK (Feature subset from checker.sh logic)                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

do_preflight_check() {
    step "Pre-flight System Check"
    local pass=0 fail=0 warn_c=0
    check_item() {
        local label="$1" cmd="$2" fix="${3:-}"
        if eval "$cmd" 2>/dev/null; then pass=$((pass+1)); log "$label"; else
            fail=$((fail+1)); err "$label — FIX: $fix"; fi
    }
    warn_item() {
        local label="$1" cmd="$2" note="${3:-}"
        if eval "$cmd" 2>/dev/null; then pass=$((pass+1)); log "$label"; else
            warn_c=$((warn_c+1)); warn "$label — $note"; fi
    }
    info "── OS ──"
    check_item "OS supported" '[[ "$DISTRO_FAMILY" =~ ^(debian|redhat|arch|suse|termux)$ ]]' "Unsupported OS"
    info "── Disk & RAM ──"
    check_item "Disk >2GB" '[[ $(df -m "$HOME" 2>/dev/null|awk "NR==2{print \$4}") -gt 2000 ]]' "Need ~2GB free"
    warn_item "RAM >1GB" '[[ $(awk "/MemTotal/{print \$2}" /proc/meminfo 2>/dev/null||echo 0) -gt 1000000 ]]' "Low RAM"
    info "── Tools ──"
    check_item "bash >=4" '[[ ${BASH_VERSINFO[0]:-0} -ge 4 ]]' "Need bash >=4"
    check_item "git" 'command -v git &>/dev/null' "$PKG_INSTALL git"
    check_item "curl/wget" 'command -v curl &>/dev/null || command -v wget &>/dev/null' "$PKG_INSTALL curl"
    info "── Ruby ──"
    warn_item "ruby >=2.7" 'command -v ruby &>/dev/null && [[ $(ruby -e "puts RUBY_VERSION.to_f" 2>/dev/null||echo 0) >= 2.7 ]]' "$PKG_INSTALL ruby ruby-dev"
    info "── PostgreSQL ──"
    warn_item "PostgreSQL" 'command -v psql &>/dev/null || command -v pg_isready &>/dev/null' "$PKG_INSTALL postgresql"
    info "── Build Tools ──"
    warn_item "gcc/make" 'command -v gcc &>/dev/null || command -v make &>/dev/null' "$PKG_INSTALL build-essential"
    info "── Network ──"
    warn_item "Internet access" 'curl -s --connect-timeout 5 https://github.com &>/dev/null' "No internet"
    echo ""
    echo -e "  ${BOLD}Results:${NC} ${GREEN}$pass pass${NC} ${YELLOW}$warn_c warn${NC} ${RED}$fail fail${NC}"
    [[ $fail -eq 0 ]] || { err "$fail prerequisite(s) missing"; return 1; }
}


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  FEATURE 11: TMUX PENTEST SESSION                                           ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

create_tmux_session() {
    step "Creating Tmux Pentest Session"
    if ! cmd_exists tmux; then
        err "tmux not installed — install it first"
        return 1
    fi
    local SESSION="pentest"
    if tmux has-session -t "$SESSION" 2>/dev/null; then
        warn "Session '$SESSION' already exists"
        ask_yesno "Kill existing & recreate?" "n" && tmux kill-session -t "$SESSION" 2>/dev/null || {
            info "Attach with: tmux attach -t $SESSION"; return 0
        }
    fi
    # Create 4-pane layout
    tmux new-session -d -s "$SESSION" -n "msfconsole"
    tmux send-keys -t "$SESSION:0.0" "echo 'Pane 1: msfconsole'; msfconsole" Enter
    tmux split-window -h -t "$SESSION:0"
    tmux send-keys -t "$SESSION:0.1" "echo 'Pane 2: Listener'; use exploit/multi/handler; set PAYLOAD windows/x64/meterpreter/reverse_tcp" Enter
    tmux split-window -v -t "$SESSION:0.0"
    tmux send-keys -t "$SESSION:0.2" "echo 'Pane 3: Web Server (for payload delivery)'; python3 -m http.server 80" Enter
    tmux split-window -v -t "$SESSION:0.1"
    tmux send-keys -t "$SESSION:0.3" "echo 'Pane 4: Recon/Enumeration'" Enter
    tmux select-layout -t "$SESSION" tiled
    log "Tmux session '$SESSION' created (4 panes)"
    info "Attach: tmux attach -t $SESSION"
    info "Kill:   tmux kill-session -t $SESSION"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  UNINSTALL (Feature 1)                                                      ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

do_uninstall() {
    banner_box
    step "UNINSTALL — Removing Everything"
    warn "This will DELETE: $INSTALL_DIR"
    warn "           and any MSF data under ~/.msf4"
    ask_yesno "ARE YOU SURE? This is irreversible" "n" || { info "Aborted."; exit 0; }

    $DRY_RUN && { info "DRY-RUN: would uninstall"; return 0; }

    # Stop services
    info "Stopping services..."
    msfdb stop 2>/dev/null || true
    sudo systemctl stop postgresql 2>/dev/null || true
    sudo systemctl stop dashboard 2>/dev/null || true

    # Remove install dir
    if [[ -d "$INSTALL_DIR" ]]; then
        rm -rf "$INSTALL_DIR" && log "Removed: $INSTALL_DIR" || err "Failed to remove $INSTALL_DIR"
    fi

    # Remove MSF data
    [[ -d "$HOME/.msf4" ]] && { rm -rf "$HOME/.msf4"; log "Removed: ~/.msf4"; }

    # Clear cache
    clear_cache

    # Restore .bashrc backup
    local latest_bak; latest_bak=$(ls -t "$HOME/.bashrc.bak."* 2>/dev/null | head -1)
    if [[ -n "$latest_bak" ]]; then
        cp "$latest_bak" "$HOME/.bashrc" && log "Restored .bashrc from $latest_bak" || warn "Failed to restore .bashrc"
    fi

    # Remove PATH additions
    info "Cleaning .bashrc PATH entries..."
    sed -i '/# metasploit-installer PATH/,/# END metasploit-installer PATH/d' "$HOME/.bashrc" 2>/dev/null || true

    # Remove cron jobs
    crontab -l 2>/dev/null | grep -v 'metasploit-installer' | crontab - 2>/dev/null || true

    step "Uninstall Complete"
    info "All traces removed. Goodbye."
    exit 0
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  HEALTH CHECK & AUTO-REPAIR (Feature 18)                                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

do_health_check() {
    step "Health Check & Auto-Repair"
    local issues=0 fixes=0

    check_fix() {
        local label="$1" check="$2" fix="${3:-}"
        if eval "$check" 2>/dev/null; then log "$label ✓"; else
            warn "$label ✗ — attempting fix..."; issues=$((issues+1))
            if [[ -n "$fix" ]]; then eval "$fix" 2>/dev/null && { log "$label FIXED"; fixes=$((fixes+1)); } || err "$label fix FAILED"; fi
        fi
    }

    check_fix "msfconsole in PATH" 'command -v msfconsole &>/dev/null' ''
    check_fix "PostgreSQL running" 'pg_isready -q 2>/dev/null || sudo -u postgres pg_isready -q 2>/dev/null' 'msfdb reinit 2>/dev/null || sudo msfdb reinit 2>/dev/null'
    check_fix "msfdb connected" 'msfconsole -q -x "db_status; exit" 2>/dev/null | grep -q connected' 'msfdb reinit 2>/dev/null'
    check_fix "Go bin in PATH" 'echo "$PATH" | grep -q "$HOME/go/bin"' "export PATH=\$HOME/go/bin:\$PATH && echo 'export PATH=\$HOME/go/bin:\$PATH' >> ~/.bashrc"
    check_fix "pipx bin in PATH" 'echo "$PATH" | grep -q "$HOME/.local/bin"' "export PATH=\$HOME/.local/bin:\$PATH && echo 'export PATH=\$HOME/.local/bin:\$PATH' >> ~/.bashrc"
    check_fix "nmap available" 'command -v nmap &>/dev/null' ''
    check_fix "git config ok" 'git config --global user.name &>/dev/null' 'git config --global user.name "Pentester" && git config --global user.email "pentester@localhost"'
    check_fix "bundler ok" 'command -v bundle &>/dev/null' 'gem install bundler 2>/dev/null'
    check_fix "ruby >=2.7" 'ruby -e "exit(RUBY_VERSION.to_f>=2.7?0:1)" 2>/dev/null' ''

    echo ""
    echo -e "  ${BOLD}Health:${NC} $issues issues, $fixes fixed"
    [[ $issues -gt $fixes ]] && warn "$((issues - fixes)) issue(s) remain — manual intervention needed"
    [[ $fixes -eq 0 && $issues -eq 0 ]] && log "All systems healthy!"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  SMOKE TEST (Feature 9)                                                     ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

run_smoke_test() {
    resume_skip "smoke_test" && return 0
    step "Smoke Test & Validation"
    local out="$INSTALL_DIR/smoke_test.md"
    local pass=0 fail=0
    mkdir -p "$(dirname "$out")"

    smoke() {
        local tool="$1" cmd="$2"
        if eval "$cmd" &>/dev/null; then
            echo "| $tool | ✅ PASS | $(eval "$cmd" 2>&1 | head -1 | tr -d '\n' | cut -c1-40) |" >> "$out.tmp"
            log "$tool PASS"; pass=$((pass+1))
        else
            echo "| $tool | ❌ FAIL | Not found or failed |" >> "$out.tmp"
            warn "$tool FAIL"; fail=$((fail+1))
        fi
    }

    $DRY_RUN && { info "DRY-RUN: would run smoke tests"; return 0; }

    {
        echo "# Smoke Test Report — $(date)"
        echo ""
        echo "| Tool | Status | Version/Info |"
        echo "|------|--------|--------------|"
    } > "$out.tmp"

    smoke "nmap" 'nmap --version 2>&1'
    smoke "msfconsole" 'msfconsole -q -x "version; exit" 2>&1'
    smoke "python3" 'python3 --version 2>&1'
    smoke "go" 'go version 2>&1'
    smoke "bloodhound" 'bloodhound --version 2>&1 || echo installed'
    smoke "crackmapexec" 'crackmapexec --version 2>&1 || echo installed'
    smoke "sqlmap" 'sqlmap --version 2>&1 | head -1'
    smoke "hydra" 'hydra -h 2>&1 | head -1'
    smoke "nikto" 'nikto -Version 2>&1'
    smoke "enum4linux" 'enum4linux 2>&1 | head -1 || echo installed'
    smoke "impacket" 'python3 -c "import impacket; print(impacket.__version__)" 2>&1 || echo installed'
    smoke "subfinder" 'subfinder -version 2>&1'
    smoke "httpx" 'httpx -version 2>&1'
    smoke "nuclei" 'nuclei -version 2>&1'
    smoke "tmux" 'tmux -V 2>&1'
    smoke "git" 'git --version 2>&1'

    cp "$out.tmp" "$out"
    rm -f "$out.tmp"

    echo "" >> "$out"
    echo "**Summary:** $pass PASS, $fail FAIL | $(date)" >> "$out"

    echo ""
    echo -e "  ${BOLD}Smoke Test:${NC} ${GREEN}$pass PASS${NC} ${RED}$fail FAIL${NC}"
    echo "  Report: $out"

    [[ $fail -eq 0 ]] || warn "Some tools failed — check $out"
    mark_done "smoke_test"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  AUTO-REPORT GENERATOR (Feature 6)                                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

generate_report() {
    step "Generating System Report"
    local report="$INSTALL_DIR/system_report.md"
    mkdir -p "$(dirname "$report")"
    $DRY_RUN && { info "DRY-RUN: would generate $report"; return 0; }

    cat > "$report" << RPEOF
# System Report — $(date -Iseconds)

## Host Info
| Item | Value |
|------|-------|
| Hostname | $(hostname) |
| Kernel | $(uname -r) |
| Arch | $(uname -m) |
| OS | $(cat /etc/os-release 2>/dev/null | grep PRETTY_NAME | cut -d= -f2 | tr -d '"') |
| Uptime | $(uptime -p) |

## Network
| Interface | IP |
|-----------|----|
$(ip -4 addr show 2>/dev/null | grep inet | awk '{print "| "$NF" | "$2" |"}' || ifconfig 2>/dev/null | grep "inet " | awk '{print "| "$NF" | "$2" |"}')

## Installed Tools
$(for t in nmap msfconsole python3 go bloodhound crackmapexec sqlmap hydra nikto enum4linux subfinder httpx nuclei tmux; do
    echo "- **$t**: $(command -v "$t" 2>/dev/null && ($t --version 2>/dev/null || echo installed) || echo 'NOT FOUND')"
done)

## Directory Structure
\`\`\`
$(find "$INSTALL_DIR" -maxdepth 3 -type d 2>/dev/null | sort | head -50)
\`\`\`

## Recommended Runbooks
1. **AD Attack:** \`bash $INSTALL_DIR/runbooks/ad-attack.sh <DOMAIN> <DC_IP> <ATTACKER_IP>\`
2. **Web Attack:** \`bash $INSTALL_DIR/runbooks/web-attack.sh <URL> <ATTACKER_IP>\`
3. **Emergency:** \`bash $INSTALL_DIR/runbooks/emergency_breakglass.sh <TARGET> <INTERFACE>\`

## Health Status
Generated: $(date)
RPEOF
    log "Report: $report"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  BROWSE MODULES (dynamic via find)                                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

list_available_modules() {
    echo ""
    echo -e "${BOLD}Available Modules:${NC}"
    echo ""
    for cat_dir in "$INSTALL_DIR"/modules/*/; do
        [[ -d "$cat_dir" ]] || continue
        local cat_name; cat_name="$(basename "$cat_dir")"
        local count; count=$(find "$cat_dir" -type f -name '*.sh' 2>/dev/null | wc -l)
        echo -e "  ${CYAN}$cat_name${NC} — $count modules"
        for sub_dir in "$cat_dir"*/; do
            [[ -d "$sub_dir" ]] || continue
            local sub_name; sub_name="$(basename "$sub_dir")"
            for f in "$sub_dir"*.sh; do
                [[ -f "$f" ]] || continue
                local fname desc; fname="$(basename "$f")"
                desc=$(head -20 "$f" 2>/dev/null | grep -i "^# Description:" | head -1 | cut -d: -f2- | sed 's/^ *//')
                [[ -z "$desc" ]] && desc="$(head -5 "$f" | grep '^# ' | head -1 | sed 's/^# *//')"
                echo -e "    ${DIM}$sub_name/${NC}${GREEN}$fname${NC} — ${desc:-module}"
            done
        done
    done
    echo ""
}

do_browse_modules() {
    step "Module Browser (Dynamic Discovery)"
    list_available_modules
    info "Run: bash msf-run.sh module <category>/<sub>/<file>"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  SELF-DIAGNOSTIC (Feature 24: LLM Helper stub)                              ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

run_ai_assistant() {
    local question="${*:-}"
    [[ -z "$question" ]] && { read -r -p "  [?] Question: " question; }
    info "AI Assistant query: $question"
    if cmd_exists ollama 2>/dev/null; then
        ollama run llama3 "$question" 2>/dev/null || warn "Ollama failed"
    elif [[ -n "${OPENAI_API_KEY:-}" ]]; then
        curl -s https://api.openai.com/v1/chat/completions \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer $OPENAI_API_KEY" \
            -d "{\"model\":\"gpt-4o-mini\",\"messages\":[{\"role\":\"user\",\"content\":\"$question\"}]}" 2>/dev/null | \
            python3 -c "import sys,json;print(json.load(sys.stdin)['choices'][0]['message']['content'])" 2>/dev/null || warn "OpenAI API failed"
    else
        warn "No AI backend available. Install ollama or set OPENAI_API_KEY in config.env"
    fi
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  INSTALL METASPLOIT FRAMEWORK                                               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

do_install_metasploit() {
    resume_skip "metasploit_installed" && return 0
    step "Installing Metasploit Framework"

    if cmd_exists msfconsole; then
        log "msfconsole already installed: $(which msfconsole)"
        mark_done "metasploit_installed"; return 0
    fi

    $DRY_RUN && { info "DRY-RUN: would install Metasploit"; return 0; }

    local MSF_CLONE="$HOME/metasploit-framework"
    if [[ ! -d "$MSF_CLONE" ]]; then
        info "Cloning metasploit-framework (this takes a while)..."
        for i in 1 2 3; do
            git clone --depth=1 https://github.com/rapid7/metasploit-framework.git "$MSF_CLONE" 2>/dev/null && break
            warn "Clone attempt $i failed — retrying..."
            sleep 5
        done
    fi

    if [[ -d "$MSF_CLONE" ]]; then
        cd "$MSF_CLONE"
        gem install bundler 2>/dev/null || true
        bundle config set --local without 'development test' 2>/dev/null || true
        for i in 1 2 3; do
            bundle install --jobs=4 2>&1 | tail -20 && break
            warn "Bundle attempt $i failed — retrying..."
            sleep 5
        done
        cd - >/dev/null
        # Link msfconsole into PATH
        mkdir -p "$HOME/bin"
        ln -sf "$MSF_CLONE/msfconsole" "$HOME/bin/msfconsole" 2>/dev/null || true
    fi

    # Initialize database
    info "Initializing MSF database..."
    msfdb init 2>/dev/null || sudo msfdb init 2>/dev/null || warn "msfdb init failed — run manually"

    if cmd_exists msfconsole; then
        log "Metasploit Framework ready"
        mark_done "metasploit_installed"
    else
        warn "Metasploit install incomplete — check logs"
    fi
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  INSTALL DASHBOARD (Feature 21)                                             ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

install_dashboard() {
    resume_skip "dashboard_installed" && return 0
    step "Installing Web Dashboard"
    info "Installing flask, flask-socketio, eventlet..."
    pipx install flask 2>/dev/null || python3 -m pip install --user flask flask-socketio eventlet 2>/dev/null || true

    # Create systemd service
    local service_file="/etc/systemd/system/metasploit-dashboard.service"
    $DRY_RUN || [[ "$USER_MODE" == "root" || "$USER_MODE" == "sudo" ]] && {
        cat > /tmp/dashboard.service << 'DASHSVC'
[Unit]
Description=Metasploit Dashboard
After=network.target

[Service]
Type=simple
User=%u
WorkingDirectory=%h/metasploit-installer/dashboard
ExecStart=%h/.local/bin/python3 app.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
DASHSVC
        priv_run "cp /tmp/dashboard.service $service_file && systemctl daemon-reload && systemctl enable metasploit-dashboard 2>/dev/null || true"
    }

    mark_done "dashboard_installed"
    log "Dashboard installed — start: systemctl start metasploit-dashboard"
}


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  FEATURE 16: MULTI-ARCH + DISTRO ADJUSTMENTS                                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

apply_arch_distro_fixes() {
    step "Architecture & Distro Adjustments"
    info "Arch: $ARCH | Distro: $DISTRO_ID ($DISTRO_FAMILY)"

    case "$DISTRO_ID" in
        kali)
            info "Kali Linux detected — optimal pentest environment"
            ;;
        parrot)
            info "Parrot OS detected — optimal pentest environment"
            ;;
        ubuntu|debian)
            info "Standard Linux — installing Kali repo for tools..."
            $DRY_RUN || {
                priv_run "wget -qO - https://archive.kali.org/archive-key.asc | sudo apt-key add - 2>/dev/null" || true
                priv_run "add-apt-repository 'deb https://http.kali.org/kali kali-rolling main non-free contrib' 2>/dev/null" || warn "Kali repo may already be present"
            }
            ;;
        *)
            info "Non-Kali distro — some tools may need manual install"
            ;;
    esac

    case "$ARCH" in
        aarch64|arm64)
            warn "ARM architecture — some binaries may not be available"
            info "Using ARM-compatible binaries where possible"
            ;;
        armv7l|arm)
            warn "32-bit ARM — limited binary support"
            info "Most tools will need to be built from source"
            ;;
    esac
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  SCHEDULED RECON SETUP (Feature 23)                                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

setup_scheduled_scan() {
    step "Scheduled Recon Setup"
    local scan_script="$INSTALL_DIR/scripts/daily_scan.sh"
    local telegram_script="$INSTALL_DIR/scripts/telegram_notify.sh"
    local cron_line="0 2 * * * bash $scan_script >> $INSTALL_DIR/scheduled_report_\$(date +\%Y\%m\%d).log 2>&1"

    if [[ -n "${TELEGRAM_BOT_TOKEN:-}" ]]; then
        cron_line="0 2 * * * bash $scan_script && bash $telegram_script >> $INSTALL_DIR/scheduled_report_\$(date +\%Y\%m\%d).log 2>&1"
        info "Telegram notifications enabled"
    fi

    # Create systemd timer (preferred) or cron fallback
    if cmd_exists systemctl 2>/dev/null; then
        local timer_file="/etc/systemd/system/msf-daily-scan.timer"
        local svc_file="/etc/systemd/system/msf-daily-scan.service"
        if [[ "$USER_MODE" == "root" || "$USER_MODE" == "sudo" ]]; then
            cat > /tmp/msf-daily-scan.service << 'SCANSVC'
[Unit]
Description=Metasploit Daily Recon Scan
After=network.target

[Service]
Type=oneshot
User=%u
ExecStart=/bin/bash %h/metasploit-installer/scripts/daily_scan.sh
SCANSVC
            cat > /tmp/msf-daily-scan.timer << 'SCANTMR'
[Unit]
Description=Daily Metasploit Recon Timer

[Timer]
OnCalendar=daily
Persistent=true

[Install]
WantedBy=timers.target
SCANTMR
            priv_run "cp /tmp/msf-daily-scan.service $svc_file && cp /tmp/msf-daily-scan.timer $timer_file && systemctl daemon-reload && systemctl enable msf-daily-scan.timer 2>/dev/null && systemctl start msf-daily-scan.timer 2>/dev/null"
            log "Systemd timer enabled (daily at 00:00)"
        fi
    else
        (crontab -l 2>/dev/null; echo "$cron_line") | crontab - 2>/dev/null && log "Cron job added (daily 02:00)" || warn "Failed to add cron"
    fi
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  LAB SPAWNER (Feature 28)                                                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

spawn_vuln_lab() {
    local lab_os="${1:-linux}" vuln="${2:-}"
    step "Spawning Vulnerable Lab: $lab_os / ${vuln:-default}"

    if ! cmd_exists docker; then
        err "Docker not installed — run setup.sh --full first"
        return 1
    fi

    cd "$INSTALL_DIR/lab"
    case "$lab_os" in
        linux)
            info "Linux targets: Metasploitable2, DVWA, VulnHub"
            docker pull vulnerables/web-dvwa 2>/dev/null && docker run -d --name dvwa -p 8081:80 vulnerables/web-dvwa 2>/dev/null && log "DVWA started on :8081"
            ;;
        windows)
            info "Windows target (if available): docker pull mcr.microsoft.com/windows/servercore"
            warn "Windows containers need Windows host — skipping on Linux"
            ;;
    esac
    info "Lab running — access via Docker"
    docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null | head -10
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  PATH SETUP                                                                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

setup_path() {
    resume_skip "path_setup" && return 0
    step "Setting Up PATH"
    local bashrc="$HOME/.bashrc"
    local added=false

    # Backup bashrc first
    if [[ -f "$bashrc" ]]; then
        cp "$bashrc" "${bashrc}.bak.$(date +%s)" 2>/dev/null || true
    fi

    local marker="# metasploit-installer PATH"
    if ! grep -qF "$marker" "$bashrc" 2>/dev/null; then
        cat >> "$bashrc" << 'PATHEOF'

# metasploit-installer PATH (auto-generated)
export PATH="$HOME/go/bin:$HOME/.local/bin:$HOME/bin:$PATH"
export GOROOT="${GOROOT:-/usr/local/go}"
# END metasploit-installer PATH
PATHEOF
        log "PATH added to ~/.bashrc"
        added=true
    else
        info "PATH already in ~/.bashrc"
    fi

    export PATH="$HOME/go/bin:$HOME/.local/bin:$HOME/bin:$PATH"
    $added || info "Run: source ~/.bashrc"
    mark_done "path_setup"
}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  POST-INSTALL: SNAPSHOT DIFF                                               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

do_snapshot_diff() {
    resume_skip "snapshot_diff" && return 0
    take_snapshot "$SNAP_POST"
    diff_snapshots
    rm -f "$SNAP_PRE" "$SNAP_POST" 2>/dev/null || true
    mark_done "snapshot_diff"
}


# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  FILE POPULATION — ALL 50+ FILES WITH REAL CONTENT                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

populate_all_files() {
    resume_skip "files_populated" && return 0
    step "Populating All Files (50+ modules)"
    local D="$INSTALL_DIR"
    $DRY_RUN && { info "DRY-RUN: would write all files"; return 0; }

    # ──────────────────────────────────────────────────────────────────
    # lib/common.sh
    # ──────────────────────────────────────────────────────────────────
    cat > "$D/lib/common.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Shared helpers — colors, logging, privilege, spinner, trap
# ==============================================================================
export RED='\033[0;31m'; export GREEN='\033[0;32m'; export YELLOW='\033[1;33m'
export BLUE='\033[0;34m'; export MAGENTA='\033[0;35m'; export CYAN='\033[0;36m'
export BOLD='\033[1m'; export DIM='\033[2m'; export NC='\033[0m'

log()   { echo -e "  ${GREEN}[✓]${NC} $*"; }
info()  { echo -e "  ${BLUE}[*]${NC} $*"; }
warn()  { echo -e "  ${YELLOW}[!]${NC} $*" >&2; }
err()   { echo -e "  ${RED}[✗]${NC} $*" >&2; }
step()  { echo -e "\n${CYAN}${BOLD}═══ $* ═══${NC}\n"; }
title() { echo -e "${MAGENTA}${BOLD}$*${NC}"; }

print_status()  { echo -e "  ${BLUE}[STATUS]${NC} $*"; }
print_error()   { echo -e "  ${RED}[ERROR]${NC} $*" >&2; }
print_success() { echo -e "  ${GREEN}[SUCCESS]${NC} $*"; }

cmd_exists() { command -v "$1" &>/dev/null; }
is_root() { [[ "${EUID:-$(id -u)}" -eq 0 ]]; }
has_sudo() { cmd_exists sudo && sudo -n true 2>/dev/null; }

user_mode() { is_root && echo "root" || { has_sudo && echo "sudo" || echo "normal"; }; }

priv_run() {
    local cmd="$1"
    case "$(user_mode)" in root) eval "$cmd" ;; sudo) eval "sudo $cmd" ;;
        normal) eval "$cmd" 2>/dev/null || { warn "Need sudo for: $cmd"; return 1; } ;; esac
}

ask_yesno() {
    local prompt="${1:-Continue?}" d="${2:-y}"; local h
    [[ "$d" == "y" ]] && h="[Y/n]" || h="[y/N]"; local a
    read -r -p "  [?] $prompt $h: " a; a="${a:-$d}"
    [[ "${a,,}" == "y" || "${a,,}" == "yes" ]]
}

confirm_action() {
    local msg="${1:-Proceed?}"
    echo -e "  ${YELLOW}[WARN]${NC} $msg"
    ask_yesno "Continue?" "n" || { info "Aborted."; return 1; }
}

spinner_pid() { local pid=$1 m="${2:-Working}"; local s="⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    while kill -0 "$pid" 2>/dev/null; do for ((i=0;i<${#s};i++)); do
        printf "\r  ${BLUE}%s${NC} %s" "${s:$i:1}" "$m"; sleep 0.1; done; done
    printf "\r  ${GREEN}✓${NC} %s Done\n" "$m"; }

backup_file() {
    local f="$1"; [[ -f "$f" ]] && cp "$f" "${f}.bak.$(date +%s)" && log "Backed up: $f" || true
}

on_exit_cleanup() {
    local ec=$?
    [[ $ec -eq 0 ]] && log "Done." || warn "Exit code: $ec"
}
trap on_exit_cleanup EXIT

resolve_path() {
    local p="$1"; [[ "$p" == /* ]] && echo "$p" || echo "$(cd "$(dirname "$0")" && pwd)/$p"
}
EOF

    # ──────────────────────────────────────────────────────────────────
    # lib/env.sh
    # ──────────────────────────────────────────────────────────────────
    cat > "$D/lib/env.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Environment detection — OS, distro, user, paths
# ==============================================================================
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/common.sh" 2>/dev/null || true

detect_os() {
    export OS_TYPE ARCH; ARCH="$(uname -m)"
    case "$(uname -s)" in Linux) OS_TYPE="linux" ;; Darwin) OS_TYPE="macos" ;; *) OS_TYPE="other" ;; esac

    if [[ -f /etc/os-release ]]; then source /etc/os-release 2>/dev/null || true; export DISTRO_ID="${ID,,}"; export DISTRO_VERSION="${VERSION_ID:-}"
    elif [[ -f /etc/arch-release ]]; then export DISTRO_ID="arch"
    elif cmd_exists termux-info 2>/dev/null; then export DISTRO_ID="termux"
    else export DISTRO_ID="unknown"; fi

    case "$DISTRO_ID" in
        ubuntu|debian|kali|parrot|linuxmint|pop|raspbian|zorin) export OS_FAMILY="debian"; export PACKAGE_MANAGER="apt"; export PKG_INSTALL_CMD="sudo apt install -y" ;;
        fedora|rhel|centos|rocky|alma|oracle) export OS_FAMILY="redhat"; export PACKAGE_MANAGER="dnf"; export PKG_INSTALL_CMD="sudo dnf install -y" ;;
        arch|manjaro|endeavouros|garuda) export OS_FAMILY="arch"; export PACKAGE_MANAGER="pacman"; export PKG_INSTALL_CMD="sudo pacman -Sy --noconfirm --needed" ;;
        opensuse*|sles) export OS_FAMILY="suse"; export PACKAGE_MANAGER="zypper"; export PKG_INSTALL_CMD="sudo zypper install -y" ;;
        termux) export OS_FAMILY="termux"; export PACKAGE_MANAGER="pkg"; export PKG_INSTALL_CMD="pkg install -y" ;;
        *) export OS_FAMILY="unknown"; export PACKAGE_MANAGER=""; export PKG_INSTALL_CMD="" ;;
    esac
    info "OS: $OS_TYPE | Distro: $DISTRO_ID | Family: $OS_FAMILY | Arch: $ARCH"
}

detect_user() {
    export CURRENT_USER="$(whoami)"; export HOME_DIR="$HOME"
    export MY_EUID="${EUID:-$(id -u)}"; export USER_MODE="$(user_mode)"
    info "User: $CURRENT_USER | Mode: $USER_MODE | Home: $HOME_DIR"
}

resolve_paths() {
    export MSF_INSTALL_DIR="${MSF_INSTALL_DIR:-$HOME/metasploit-framework}"
    export MSF_DIR="${MSF_DIR:-$HOME/.msf4}"
    export PG_DATA_DIR="${PG_DATA_DIR:-$MSF_DIR/postgres}"
    export BIN_DIR="${BIN_DIR:-$HOME/bin}"
    export STATE_FILE="${STATE_FILE:-$HOME/.msf-setup-state}"
}

detect_all() { detect_os; detect_user; resolve_paths; }
EOF

    # ──────────────────────────────────────────────────────────────────
    # lib/checker.sh
    # ──────────────────────────────────────────────────────────────────
    cat > "$D/lib/checker.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Pre-flight checker — validates all prerequisites
# ==============================================================================
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/common.sh" 2>/dev/null || true
source "$script_dir/env.sh" 2>/dev/null || true
detect_all 2>/dev/null || true

check_root() {
    if is_root; then warn "Running as ROOT — PostgreSQL initdb will FAIL"
        info "SOLUTION: useradd -m msfuser && su - msfuser"
    fi
}

check_internet() {
    info "Checking internet connectivity..."
    if curl -s --connect-timeout 5 https://github.com >/dev/null 2>&1; then log "Internet: OK"
    elif wget -q --timeout=5 -O /dev/null https://github.com 2>&1; then log "Internet: OK (wget)"
    else err "No internet access to github.com"; return 1; fi
}

check_dependency() {
    local tool="$1" hint="${2:-}"
    cmd_exists "$tool" && { log "$tool: $(command -v "$tool")"; return 0; }
    err "$tool: NOT FOUND"; [[ -n "$hint" ]] && info "Install: $hint"
    return 1
}

check_os() {
    info "Checking OS compatibility..."
    case "${OS_FAMILY:-unknown}" in debian|redhat|arch|suse|termux) log "OS $OS_FAMILY supported" ;;
        *) err "Unsupported OS: ${DISTRO_ID:-unknown}"; info "Supported: Debian/Ubuntu, Fedora/RHEL, Arch, SUSE, Termux"; return 1 ;; esac
}

check_arch() {
    info "Architecture: ${ARCH:-unknown}"
    case "${ARCH:-}" in x86_64|aarch64|arm64) log "Arch OK" ;;
        *) warn "Unusual arch — some tools may not work" ;; esac
}

run_all_checks() {
    local pass=0 fail=0
    step "Pre-flight System Check"
    check_os || ((fail++))
    check_arch || ((fail++))
    check_root
    check_internet || ((fail++))
    check_dependency git "$PKG_INSTALL_CMD git" && ((pass++)) || ((fail++))
    check_dependency curl "$PKG_INSTALL_CMD curl" && ((pass++)) || ((fail++))
    check_dependency ruby "$PKG_INSTALL_CMD ruby ruby-dev" && ((pass++)) || ((fail++))
    check_dependency bundle "gem install bundler" && ((pass++)) || ((fail++))
    check_dependency psql "$PKG_INSTALL_CMD postgresql" && ((pass++)) || ((fail++))
    check_dependency gcc "$PKG_INSTALL_CMD build-essential" && ((pass++)) || ((fail++))
    check_dependency nmap "$PKG_INSTALL_CMD nmap" && ((pass++)) || ((fail++))
    echo ""
    echo -e "  Results: ${GREEN}$pass PASS${NC} ${RED}$fail FAIL${NC}"
    [[ $fail -eq 0 ]] || return 1
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then run_all_checks; fi
EOF

    # ──────────────────────────────────────────────────────────────────
    # lib/deps.sh
    # ──────────────────────────────────────────────────────────────────
    cat > "$D/lib/deps.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Smart dependency installer for all supported distros
# ==============================================================================
set -euo pipefail
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/common.sh" 2>/dev/null || true
source "$script_dir/env.sh" 2>/dev/null || true
detect_all 2>/dev/null || true

install_system_deps() {
    step "Installing System Dependencies"
    declare -A PKG_MAP
    case "${OS_FAMILY:-debian}" in
        debian)
            PKG_MAP=([git]="git" [curl]="curl" [ruby]="ruby ruby-dev" [build]="build-essential"
                [postgresql]="postgresql postgresql-contrib libpq-dev" [nmap]="nmap"
                [libpcap]="libpcap-dev" [libsqlite]="libsqlite3-dev" [libxml]="libxml2-dev libxslt1-dev"
                [libcurl]="libcurl4-openssl-dev" [pandoc]="pandoc texlive-latex-base wkhtmltopdf"
                [docker]="docker.io docker-compose")
            INSTALL_CMD="sudo apt-get install -y --no-install-recommends"
            UPDATE_CMD="sudo apt-get update -qq" ;;
        *)
            INSTALL_CMD="$PKG_INSTALL_CMD"; UPDATE_CMD="" ;;
    esac
    [[ -n "${UPDATE_CMD:-}" ]] && $UPDATE_CMD 2>/dev/null || true
    for key in git curl ruby build postgresql nmap libpcap libsqlite libxml libcurl; do
        local pkgs="${PKG_MAP[$key]:-}"
        [[ -z "$pkgs" ]] && { warn "No pkg map for $key"; continue; }
        info "Installing $key: $pkgs"
        $INSTALL_CMD $pkgs 2>/dev/null && log "$key done" || {
            warn "Batch failed for $key — per-package fallback"
            for p in $pkgs; do $INSTALL_CMD "$p" 2>/dev/null && log "  $p" || warn "  $p skipped"; done
        }
    done
}

install_ruby_gems() {
    step "Ruby Gems"
    for g in bundler pg activerecord; do
        gem install "$g" 2>/dev/null && log "gem $g" || warn "gem $g failed"
    done
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then install_system_deps; install_ruby_gems; fi
EOF

    # ──────────────────────────────────────────────────────────────────
    # lib/root-bridge.sh
    # ──────────────────────────────────────────────────────────────────
    cat > "$D/lib/root-bridge.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Root/non-root bridge — safe sudo execution, user creation, PG fix
# ==============================================================================
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/common.sh" 2>/dev/null || true

run_as_root() {
    local cmd="$1"
    case "$(user_mode)" in root) eval "$cmd" ;;
        sudo) eval "sudo $cmd" ;;
        normal) eval "$cmd" 2>/dev/null || { err "This command requires root/sudo: $cmd"; return 1; } ;;
    esac
}

bridge_check() {
    if is_root; then
        warn "PostgreSQL initdb refuses to run as root"
        info "Create normal user & re-run: useradd -m -s /bin/bash msfuser && su - msfuser"
        if ask_yesno "Create user 'msfuser' now?" "y"; then
            useradd -m -s /bin/bash msfuser 2>/dev/null && log "User msfuser created" || warn "User may already exist"
            info "Switch: su - msfuser && cd $(pwd) && bash setup-metasploit.sh"
            exit 0
        fi
    fi
}

bridge_create_user() {
    local u="${1:-msfuser}"
    is_root || { err "Need root to create user"; return 1; }
    id "$u" &>/dev/null && { log "User $u exists"; return 0; }
    useradd -m -s /bin/bash "$u" && log "Created $u" || { err "Failed"; return 1; }
    cp -r "$(pwd)" "/home/$u/" 2>/dev/null && chown -R "$u:$u" "/home/$u/$(basename "$(pwd)")" 2>/dev/null
    info "su - $u && cd $(basename "$(pwd)") && bash setup-metasploit.sh"
}

bridge_fix_pg_perms() {
    local data="${1:-$HOME/.msf4/postgres}"
    [[ -f "$data/PG_VERSION" ]] || return 0
    local owner; owner=$(stat -c '%U' "$data" 2>/dev/null || echo "")
    [[ "$owner" == "root" ]] && ! is_root && { warn "PG owned by root — fixing"; sudo chown -R "$(whoami):" "$data"; log "Fixed"; }
}

bridge_all() { bridge_check; bridge_fix_pg_perms; }
EOF

    log "lib/*.sh (5 files) written"

    # ──────────────────────────────────────────────────────────────────
    # lib/fuzzer.sh (NEW) — HTTP Parameter Fuzzing Engine
    # ──────────────────────────────────────────────────────────────────
    cat > "$D/lib/fuzzer.sh" << 'EOF'
#!/usr/bin/env bash
# Description: HTTP parameter fuzzing engine for vulnerability discovery
# ==============================================================================
target="${1:-}"; param="${2:-id}"; wordlist="${3:-/usr/share/seclists/Discovery/Web-Content/common.txt}"
[[ -z "$target" ]] && { echo "Usage: bash fuzzer.sh <URL> [param] [wordlist]"; echo "  Example: bash fuzzer.sh http://target.com/page.php?id=FUZZ id /path/to/wordlist.txt"; exit 1; }

fuzz_http_param() {
    local t="$1" p="$2" w="$3"
    echo -e "\n=== FUZZING $t?$p=FUZZ ===\n"
    if cmd_exists ffuf; then
        ffuf -u "${t}?${p}=FUZZ" -w "$w" -fc 404 -t 100 -o /tmp/ffuf_results.json 2>/dev/null
        log "Results: /tmp/ffuf_results.json"
    elif cmd_exists wfuzz; then
        wfuzz -c -z file,"$w" --hc 404 "${t}?${p}=FUZZ"
    elif cmd_exists gobuster; then
        gobuster fuzz -u "${t}?${p}=FUZZ" -w "$w" --exclude-length 0
    else
        warn "No fuzzer found (ffuf/wfuzz/gobuster). Install one: go install github.com/ffuf/ffuf/v2@latest"
    fi
}

fuzz_http_multipart() {
    local t="$1" w="$2"
    echo -e "\n=== MULTIPART FUZZING $t ===\n"
    cmd_exists ffuf && ffuf -u "$t" -w "$w" -H "Content-Type: multipart/form-data" -d "file=FUZZ" -fc 404 -t 50
}

fuzz_http_headers() {
    local t="$1" w="${2:-/usr/share/seclists/Discovery/Web-Content/common.txt}"
    echo -e "\n=== HEADER FUZZING $t ===\n"
    cmd_exists ffuf && ffuf -u "$t" -w "$w" -H "FUZZ: test" -fc 404 -t 50
}

# Auto-run if args provided
[[ -n "$target" ]] && fuzz_http_param "$target" "$param" "$wordlist"
EOF

    # ──────────────────────────────────────────────────────────────────
    # lib/validator.sh (NEW — Feature 19) — True Positive Validation
    # ──────────────────────────────────────────────────────────────────
    cat > "$D/lib/validator.sh" << 'EOF'
#!/usr/bin/env bash
# Description: Automated vulnerability validator — confirms true/false positives
# ==============================================================================
ip="${1:-}"; port="${2:-}"; cve="${3:-}"; outfile="${4:-validated_findings.json}"
[[ -z "$ip" ]] && { echo "Usage: bash validator.sh <IP> [port] [CVE]"; exit 1; }

validate_finding() {
    local host="$1" p="$2" vuln="${3:-unknown}"
    local status="UNVERIFIED" evidence=""
    echo -e "\n=== VALIDATING $host:$p ($vuln) ===\n"

    # SMB MS17-010 check
    if [[ "$vuln" =~ MS17-010|ms17_010|eternalblue ]]; then
        info "Checking MS17-010..."
        if nmap --script smb-vuln-ms17-010 -p "$p" "$host" 2>/dev/null | grep -qi "VULNERABLE"; then
            status="CONFIRMED"; evidence="nmap smb-vuln-ms17-010 returned VULNERABLE"
        else
            msfconsole -q -x "use auxiliary/scanner/smb/smb_ms17_010; set RHOSTS $host; run; exit" 2>/dev/null | grep -qi "vulnerable" && { status="CONFIRMED"; evidence="msf smb_ms17_010 detected"; } || status="FALSE_POSITIVE"
        fi
    fi

    # BlueKeep check
    if [[ "$vuln" =~ CVE-2019-0708|BlueKeep|bluekeep ]]; then
        info "Checking BlueKeep..."
        if nmap --script rdp-vuln-ms12-020 -p "$p" "$host" 2>/dev/null | grep -qi "VULNERABLE"; then
            status="CONFIRMED"; evidence="nmap rdp check"
        else
            msfconsole -q -x "use auxiliary/scanner/rdp/cve_2019_0708_bluekeep; set RHOSTS $host; run; exit" 2>/dev/null | grep -qi "vulnerable" && { status="CONFIRMED"; evidence="msf bluekeep check"; } || status="FALSE_POSITIVE"
        fi
    fi

    # HTTP CVE check
    if [[ "$vuln" =~ CVE-|http ]]; then
        info "Nuclei check..."
        nuclei -u "${host}:${p}" -t cves/ -silent 2>/dev/null | head -5 && { status="CONFIRMED"; evidence="nuclei detection"; } || status="FALSE_POSITIVE"
    fi

    # Write JSON
    mkdir -p "$(dirname "$outfile")" 2>/dev/null
    echo "{\"host\":\"$host\",\"port\":\"$p\",\"cve\":\"$vuln\",\"status\":\"$status\",\"evidence\":\"$evidence\",\"time\":\"$(date -Iseconds)\"}" >> "$outfile"
    echo ""
    echo -e "  Result: ${BOLD}$status${NC}"
    [[ "$status" == "CONFIRMED" ]] || [[ "$status" == "UNVERIFIED" ]]
}

validate_finding "$ip" "$port" "$cve"
EOF

    # ──────────────────────────────────────────────────────────────────
